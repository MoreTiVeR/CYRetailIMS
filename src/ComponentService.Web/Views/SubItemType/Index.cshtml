
@{
	ViewData["Title"] = "ประเภทสินค้าย่อย";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
	<div class="page-title">
		<h4>ประเภทสินค้าย่อย</h4>
		<h6>รายการประเภทสินค้าย่อย</h6>
	</div>
	<div class="page-btn">
		<a asp-action="CreateItemType" asp-controller="ItemType" class="btn btn-added"><img src="~/assets/img/icons/plus.svg" alt="img" class="me-1">เพิ่มประเภทสินค้าย่อยใหม่</a>
	</div>
</div>

<!-- /product list -->
<div class="card">
	<div class="card-body">
		<div class="table-top">
			<div class="search-set">
				<div class="search-path">
					<a class="btn btn-filter" id="filter_search">
						<img src="~/assets/img/icons/filter.svg" alt="img">
						<span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
					</a>
				</div>
				<div class="search-input">
					<a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
				</div>
			</div>
		</div>
		<!-- /Filter -->
		<div class="card mb-0" id="filter_inputs">
			<div class="card-body pb-0">
				<div class="row">
					<div class="col-lg-3 col-sm-6 col-12">
					</div>
					<div class="col-lg-3 col-sm-6 col-12">
					</div>
					<div class="col-lg-3 col-sm-6 col-12">
					</div>
					<div class="col-lg-3 col-sm-6 col-12">
					</div>
				</div>
			</div>
		</div>
		<!-- /Filter -->
		<div class="table-responsive">
			<table id="tbItemType" class="table">
				<thead>
					<tr>
						<th hidden>
							<label class="checkboxs">
								<input type="checkbox" id="select-all">
								<span class="checkmarks"></span>
							</label>
						</th>
						<th hidden>SubItemID</th>
						<th>ชื่อประเภทย่อย</th>
						<th class="text-center">รายละเอียด</th>
						<th>สร้างโดย</th>
						<th>วันที่สร้าง</th>
						<th>แก้ไขโดย</th>
						<th>วันที่แก้ไข</th>
						<th class="text-center">สถานะ</th>
						<th>ดำเนินการ</th>
					</tr>
				</thead>
				<tbody>
				</tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {

	<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
	<script type="text/javascript" charset="utf8" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
	<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

	<script src="~/js/view/subitemtype/subitemtype_index.js" asp-append-version="true"></script>
}