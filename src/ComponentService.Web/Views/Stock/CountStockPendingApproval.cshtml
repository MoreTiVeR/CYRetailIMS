@{
	ViewData["Title"] = "รออนุมัติ — นับสต๊อก";
	Layout = "~/Views/Shared/_Layout.cshtml";
	bool isAdmin = ViewBag.IsAdmin is bool b && b;
}

<link href="~/css/site.css" rel="stylesheet" />

<style>
	/* =========================
   Page Header
   ========================= */

	.stock-approval-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;

		margin-bottom: 24px;
	}

	.stock-approval-header .page-title {
		margin: 0;
	}

	.stock-approval-header .page-title h4 {
		margin-bottom: 5px;
		font-size: 20px;
		font-weight: 700;
		color: #1f2937;
	}

	.stock-approval-header .page-title h6 {
		margin: 0;
		font-size: 14px;
		font-weight: 400;
		color: #667085;
	}


	/* =========================
	Action Area
	========================= */

	.page-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 10px;

		flex-shrink: 0;
	}


	/* Base button */
	.page-actions .btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 7px;

		min-height: 40px;
		padding: 8px 14px;

		border-radius: 7px;

		font-size: 14px;
		font-weight: 600;
		line-height: 1;

		white-space: nowrap;
		text-decoration: none;

		transition: all 0.15s ease;
	}

	.page-actions .btn .fe {
		font-size: 17px;
	}


	/* =========================
	Back button
	========================= */

	.btn-back {
		background: #ffffff;
		border: 1px solid #d0d5dd;
		color: #475467;
	}

	.btn-back:hover,
	.btn-back:focus {
		background: #f9fafb;
		border-color: #98a2b3;
		color: #344054;

		transform: translateY(-1px);
	}


	/* =========================
	Report button
	========================= */

	.btn-report {
		background: #f79009;
		border: 1px solid #f79009;
		color: #ffffff;
	}

	.btn-report:hover,
	.btn-report:focus {
		background: #dc6803;
		border-color: #dc6803;
		color: #ffffff !important;

		transform: translateY(-1px);
		box-shadow: 0 3px 8px rgba(247, 144, 9, 0.22);
	}


	/* =========================
	Responsive
	========================= */

	@@media (max-width: 767px) {

		.stock-approval-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 15px;
		}

		.page-actions {
			width: 100%;
			justify-content: flex-start;
		}
	}
</style>
<style>
	.stock-action-group {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.stock-action {
    width: 36px;
    height: 36px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid transparent;
    border-radius: 7px;

    background: transparent;

    font-size: 19px;
    text-decoration: none;

    cursor: pointer;

    transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease;
}

.stock-action .fe {
    font-size: 19px;
}


/* ======================
   Approve
   ====================== */

.stock-action-approve {
    color: #2563eb;
}

.stock-action-approve:hover,
.stock-action-approve:focus {
    color: #1d4ed8;
    background: #eff6ff;
    border-color: #bfdbfe;
    transform: translateY(-1px);
}


/* ======================
   Excel
   ====================== */

.stock-action-excel {
    color: #16a34a;
}

.stock-action-excel:hover,
.stock-action-excel:focus {
    color: #15803d;
    background: #f0fdf4;
    border-color: #bbf7d0;
    transform: translateY(-1px);
}


/* ======================
   Cancel
   ====================== */

.stock-action-cancel {
    color: #ef4444;
}

.stock-action-cancel:hover,
.stock-action-cancel:focus {
    color: #dc2626;
    background: #fef2f2;
    border-color: #fecaca;
    transform: translateY(-1px);
}


/* ป้องกัน theme เดิม override สี */
.stock-action:hover,
.stock-action:focus {
    text-decoration: none !important;
}
</style>

<div class="page-header stock-approval-header">
    <div class="page-title">
        <h4>รออนุมัติ — นับสต๊อก</h4>
        <h6>รายการนับสต๊อกที่ส่งมารอการอนุมัติ</h6>
    </div>

	<div class="page-actions">
@*         <a asp-controller="Stock"
		   asp-action="Index"
		   class="btn btn-back">
			<i class="fe fe-arrow-left"></i>
			<span>ย้อนกลับ</span>
		</a> *@

        @if (isAdmin)
        {
            <a asp-controller="Report"
               asp-action="CountStockApprovalReport"
               class="btn btn-report">
                <i class="fe fe-file-text"></i>
                <span>รายงานอนุมัติ</span>
            </a>
        }
    </div>
</div>

@if (isAdmin)
{
	<div class="alert alert-info" role="alert">
		สามารถ<strong>อนุมัติ</strong>ได้เฉพาะรายการที่ส่งโดย<strong> หัวหน้า PC </strong>เท่านั้น •
		รายการพนักงานขาย (PC) ดูข้อมูลได้อย่างเดียว
	</div>
}

<div class="card">
	<div class="card-body">
		<div class="table-top">
			<div class="search-set">
				<div class="search-path">
					<a class="btn btn-filter" id="filter_search">
						<img src="~/assets/img/icons/filter.svg" alt="img">
						<span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
					</a>
				</div>
				<div class="search-input">
					<a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
				</div>
			</div>
		</div>

		<!-- Filter -->
		<div class="card mb-0" id="filter_inputs">
			<div class="card-body pb-0">
				<div class="row">
					<div class="col-lg-3 col-sm-6 col-12">
						<div class="form-group">
							<label>ผู้นับ</label>
							<select id="ddlCounterRole" class="select2 ddl-select2">
								<option value="">--ทั้งหมด--</option>
								<option value="PC">พนักงานขาย (PC)</option>
								<option value="HeadPC">หัวหน้า PC</option>
							</select>
						</div>
					</div>
					<div class="col-lg-3 col-sm-6 col-12">
						<div class="form-group">
							<label>สถานะ</label>
							<select id="ddlApproveStatus" class="select2 ddl-select2">
								<option value="">--ทั้งหมด--</option>
								<option value="0">แบบร่าง</option>
								<option value="1" selected>รออนุมัติ</option>
								<option value="2">อนุมัติแล้ว</option>
							</select>
						</div>
					</div>
					<div class="col-lg-3 col-sm-6 col-12">
						<div class="form-group" style="text-align: left">
							<label>&nbsp;</label>
							<a id="btnSearchApproval" class="btn btn-filters" title="ค้นหา"><img src="~/assets/img/icons/search-whites.svg" alt="img"></a>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /Filter -->

		<div class="table-responsive">
			<table id="tbPendingApproval" class="table">
				<thead>
					<tr>
						<th hidden>เลขที่</th>
						<th hidden>รหัสสาขา</th>
						<th>วันที่นับ</th>
						<th>ชื่อสาขา</th>
						<th>ผู้นับ</th>
						<th style="text-align:center">สถานะ</th>
						<th style="text-align:center">วันรออนุมัติ</th>
						<th style="text-align:center">ดาวน์โหลด</th>
						@if (isAdmin)
						{
							<th style="text-align:center">ดำเนินการ</th>
						}
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>
</div>

<!-- Confirm Approve Modal -->
<div class="modal fade" id="modalConfirmApprove" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">ยืนยันการอนุมัติ</h5>
				<button type="button" class="close" data-bs-dismiss="modal">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<p>คุณต้องการ <strong>อนุมัติ</strong> รายการนับสต๊อกนี้ใช่หรือไม่?</p>
				<div class="alert alert-warning mb-0">
					เมื่ออนุมัติแล้ว ระบบจะ <strong>ปรับสต๊อกทันที</strong> ให้เท่ากับยอดที่หัวหน้า PC นับได้
					และไม่สามารถยกเลิกได้
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
				<button type="button" id="btnConfirmApprove" class="btn btn-submit">
					ยืนยันอนุมัติ
				</button>
			</div>
		</div>
	</div>
</div>

<input type="hidden" id="hdnIsAdmin" value="@isAdmin.ToString().ToLower()" />

@section Scripts {
	<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
	<script type="text/javascript" charset="utf8" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
	<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
	<script src="~/js/view/countstock/countstock_approval.js" asp-append-version="true"></script>
}
