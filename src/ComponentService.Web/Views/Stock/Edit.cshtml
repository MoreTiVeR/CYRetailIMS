@using CYRetailIMS.Application.Services.CountStockService.Queries.InquiryCountStockByID.v1

@model InquiryCountStockByIDResponseDTO

@{
	ViewData["Title"] = "EditCountStock";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var countstockid = Model.countstockid;
}

<style type="text/css">
	.custom-textarea {
		width: 100%;
		height: 150px; /* Initial height */
		padding: 10px;
		font-size: 16px;
		border: 1px solid #ccc;
		border-radius: 5px;
		resize: none;
		box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
		outline: none;
	}

		.custom-textarea:focus {
			border-color: #007bff;
			box-shadow: 0px 0px 5px rgba(0, 123, 255, 0.5);
		}

	/* Editable cells (if using contenteditable) */
	td[contenteditable="true"] {
		outline: none; /* Remove default focus outline */
	}

		/* Highlight cell when focused */
		td[contenteditable="true"]:focus {
			background-color: #e9f7ff; /* Light blue background */
			border: 1px solid #007bff; /* Blue border */
			box-shadow: 0 0 5px rgba(0, 123, 255, 0.75); /* Blue glow effect */
		}

	/* Custom label styling */
	.custom-label {
		display: block; /* Ensure the label is treated as a block element */
		font-size: 14px; /* Adjust font size */
		font-weight: 500; /* Slightly bold for better readability */
		color: #333; /* Dark text color */
		margin-bottom: 5px; /* Add space below the label */
		position: relative; /* Needed for underline styling */
	}


	.label-width {
		width: 100px; /* Set the same width for all labels */
		display: inline-block; /* Ensure width is applied */
	}

	.editable:empty::before {
		content: 'ระบุจำนวน'; /* Placeholder text */
		color: gray;
		font-style: italic;
	}

	.editable:focus::before {
		content: ''; /* Remove placeholder when cell is focused */
	}
</style>

<div class="page-header">
	<div class="page-title">
		<h4>แก้ไข</h4>
		<h6>แก้ไขรายการนับสต๊อก</h6>
	</div>
</div>

<!-- /content -->
<div class="card">
	<div class="card-body">
		<input type="hidden" id="countStockIdHidden" value="@Model.countstockid" />
		<div class="row">
			<div class="col-lg-6 col-sm-6 col-12">
				<div class="row mb-3">
					<label for="colFormLabelSm" class="col-sm-2 col-lg-3 col-form-label col-form-label-sm">สาขา</label>
					<div class="col-sm-10 col-lg-9">
						@Html.DropDownListFor(model => model.branchid, new SelectList(ViewBag.BranchList, "Value", "Text", null, null), "- กรุณาเลือกสาขา -", new { @class = "select2 form-control" })
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-sm-6 col-12">
			</div>
			<div class="col-lg-3 col-sm-6 col-12">
			</div>
		</div>
		<div class="row">
			<div class="col-lg-6 col-sm-6 col-12">
				<div class="row mb-3">
					<label for="colFormLabelSm" class="col-sm-2 col-lg-3 col-form-label col-form-label-sm">ประเภท</label>
					<div class="col-sm-10 col-lg-9">
						<select id="ddlItemType" class="form-control ddl-select2 select2 ddl-source-itemtype" asp-items="@(new SelectList(ViewBag.ItemTypeList, "Value", "Text", null, null))">
							<option value="">--ทั้งหมด--</option>
						</select>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-sm-6 col-12">
			</div>
			<div class="col-lg-3 col-sm-6 col-12">
			</div>
		</div>
		<div class="row">
			<div class="col-lg-12 col-sm-12 col-12">
				@* <textarea id="dynamicTextarea" maxlength="200" class="custom-textarea" placeholder="หมายเหตุ (ถ้ามี)"></textarea> *@
				<div class="form-group">
					<label>รายละเอียด</label>
					@Html.TextAreaFor(m => m.remark, new
						{
							@class = "form-control full-width",
							@style = "resize: none;",
							@cols = 5,
							@rows = 3,
							@maxlength = 200,
							value = "",
							placeholder = Html.DisplayNameFor(n => n.remark)
						})
				</div>
			</div>
			<hr />
		</div>
		<form id="countStockForm">
			<div class="table-responsive">
				<table id="countStockTable" class="table">
					<thead>
						<tr>
							<th>ประเภท</th>
							<th>รหัสประเภทย่อย</th>
							<th>ประเภทย่อย</th>
							<th>รหัสสินค้า</th>
							<th>รหัสสาขา</th>
							<th>สต๊อกหน้าร้าน(ระบบ)</th>
							<th>สต๊อกหน้าร้าน</th>
							<th>ยอดนับได้</th>
							<th>รอเติม</th>
							<th>ชำรุด</th>
							<th>ขายก่อนนับ</th>
							<th>รวมนับได้</th>
							<th>ขาด/เกิน</th>
						</tr>
					</thead>
					<tbody>
					</tbody>
				</table>
			</div>
			<div class="text-center">
				<button id="btnCancel" class="btn btn-submit mt-3">ยกเลิก</button>
				<button id="btnSaveCountStock" name="btnCreate" class="btn btn-submit mt-3">
					<i class="bx bx-plus"></i>
					บันทึกข้อมูล
				</button>
			</div>
		</form>
	</div>
</div>
<!-- /content -->

<!-- /content -->
@section Scripts {

	<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
	<script type="text/javascript" charset="utf8" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
	<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

	<!--charactersRemaining-->
	<script src="~/lib/display-remaining-characters/jquery.charactersRemaining.min.js"></script>
	<script src="~/js/view/countstock/countstock_edit.js" asp-append-version="true"></script>
	
}
