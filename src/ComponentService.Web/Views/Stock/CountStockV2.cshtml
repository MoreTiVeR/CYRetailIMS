@{
    ViewData["Title"] = "CountStockV2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .diff-badge-shortage  { background-color: #dc3545; color: #fff; }
    .diff-badge-surplus   { background-color: #198754; color: #fff; }
    .diff-badge-balanced  { background-color: #6c757d; color: #fff; }

    .summary-card {
        border-radius: 10px;
        transition: box-shadow .2s;
    }
    .summary-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.12); }

    .physical-count {
        width: 110px;
        margin: auto;
        text-align: center;
    }

    #loadingPlaceholder .placeholder-row td {
        padding: 12px 0;
    }

    .table-countstock thead th {
        white-space: nowrap;
        vertical-align: middle;
    }
    .table-countstock tbody td {
        vertical-align: middle;
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <div class="page-title">
        <h4>นับสต๊อก <span class="badge bg-primary ms-1" style="font-size:0.65em;vertical-align:middle;">V2</span></h4>
        <h6>ระบุเฉพาะจำนวนที่มีอยู่จริง ระบบคำนวณให้อัตโนมัติ</h6>
    </div>
    <div class="page-btn">
        <a href="/Stock/Index" class="btn btn-secondary">
            <i class="bx bx-arrow-back me-1"></i>กลับรายการ
        </a>
    </div>
</div>

<!-- Header Card: Branch + Date + Remark -->
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-lg-4 col-sm-12">
                <label class="form-label fw-semibold">สาขา <span class="text-danger">*</span></label>
                <select id="ddlBranch" class="form-control select2"
                        asp-items="@(new SelectList(ViewBag.BranchList, "Value", "Text", null, null))">
                    <option value="">-- กรุณาเลือกสาขา --</option>
                </select>
            </div>
            <div class="col-lg-3 col-sm-6">
                <label class="form-label fw-semibold">วันที่นับสต๊อก</label>
                <input type="text" id="txtCountDate" class="form-control"
                       readonly value="@DateTime.Now.ToString("dd/MM/yyyy")" />
            </div>
            <div class="col-lg-5 col-sm-6">
                <label class="form-label fw-semibold">หมายเหตุ</label>
                <input type="text" id="txtRemark" class="form-control"
                       maxlength="200" placeholder="หมายเหตุ (ถ้ามี)" />
            </div>
        </div>
    </div>
</div>

<!-- Summary Cards (hidden until branch is selected) -->
<div id="summarySection" class="row g-3 mb-3" style="display:none;">
    <div class="col-lg-3 col-sm-6">
        <div class="card summary-card border-0 shadow-sm h-100">
            <div class="card-body text-center py-3">
                <div class="text-muted small mb-1">รายการทั้งหมด</div>
                <div class="display-6 fw-bold text-primary" id="sumTotalItems">0</div>
                <div class="small text-muted">รายการ</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card summary-card border-0 shadow-sm h-100">
            <div class="card-body text-center py-3">
                <div class="text-muted small mb-1">สต๊อกรวมในระบบ</div>
                <div class="display-6 fw-bold text-info" id="sumSystemQty">0</div>
                <div class="small text-muted">ชิ้น</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card summary-card border-0 shadow-sm h-100">
            <div class="card-body text-center py-3">
                <div class="text-muted small mb-1">นับได้จริง</div>
                <div class="display-6 fw-bold text-success" id="sumCountedQty">0</div>
                <div class="small text-muted">ชิ้น</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card summary-card border-0 shadow-sm h-100" id="diffSummaryCard">
            <div class="card-body text-center py-3">
                <div class="text-muted small mb-1">ขาด / เกิน (รวม)</div>
                <div class="display-6 fw-bold" id="sumDifference">0</div>
                <div class="small text-muted">ชิ้น</div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Indicator -->
<div id="loadingOverlay" class="card" style="display:none;">
    <div class="card-body text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status" style="width:3rem;height:3rem;"></div>
        <div class="text-muted">กำลังโหลดข้อมูลสินค้าจากสาขา...</div>
    </div>
</div>

<!-- Empty State -->
<div id="emptyState" class="card" style="display:none;">
    <div class="card-body text-center py-5">
        <i class="bx bx-package text-muted" style="font-size:3rem;"></i>
        <p class="text-muted mt-2 mb-0">ไม่พบข้อมูลสินค้าในสาขานี้</p>
    </div>
</div>

<!-- Table Section -->
<div id="tableSection" class="card" style="display:none;">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-semibold">รายการสินค้าเพื่อนับสต๊อก</span>
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width:220px;">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bx bx-search text-muted"></i>
                </span>
                <input type="text" id="txtSearch" class="form-control border-start-0 ps-0"
                       placeholder="ค้นหาประเภทย่อย..." />
            </div>
            <button id="btnResetAll" class="btn btn-sm btn-outline-secondary" title="ตั้งค่าจำนวนทั้งหมดเป็น 0">
                <i class="bx bx-reset me-1"></i>รีเซ็ต
            </button>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm table-countstock mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center ps-3" style="width:50px;">#</th>
                        <th style="width:120px;">รหัสสินค้า</th>
                        <th>ชื่อสินค้า</th>
                        <th style="width:120px;">ประเภทย่อย</th>
                        <th class="text-center" style="width:160px;">
                            สต๊อกในระบบ
                            <i class="bx bx-info-circle text-muted ms-1"
                               title="จำนวนสินค้าในระบบ ณ วันที่นับสต๊อก" data-bs-toggle="tooltip"></i>
                        </th>
                        <th class="text-center" style="width:190px;">
                            จำนวนที่มีอยู่จริง <span class="text-danger">*</span>
                        </th>
                        <th class="text-center" style="width:130px;">ขาด / เกิน</th>
                    </tr>
                </thead>
                <tbody id="countStockV2Body">
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="text-muted small" id="visibleRowCount"></div>
        <div class="d-flex gap-2">
            <a href="/Stock/Index" class="btn btn-outline-secondary">
                <i class="bx bx-x me-1"></i>ยกเลิก
            </a>
            <button id="btnSaveCountStockV2" class="btn btn-primary">
                <i class="bx bx-save me-1"></i>บันทึกข้อมูล
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/view/countstock/countstock_v2_create.js" asp-append-version="true"></script>
}
