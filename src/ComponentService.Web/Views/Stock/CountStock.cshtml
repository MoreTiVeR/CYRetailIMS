					<select id="ddlItemType" class="form-control ddl-select2 select2 ddl-source-itemtype" asp-items="@(new SelectList(ViewBag.ItemTypeList, "Value", "Text", null, null))">
						<option value="">--ทั้งหมด--</option>
					</select>
				</div>
			</div>
			<div class="col-lg-3 col-sm-6 col-12">
				
			</div>
			<div class="col-lg-3 col-sm-6 col-12">
			</div>
		</div> *@
		<form id="countStockForm">
			<div class="table-responsive">
				<table id="countStockTable" class="table">
					<thead>
						<tr>
							<th>ประเภท</th>
							<th>ประเภทย่อย</th>
							<th>รหัสสินค้า</th>
							<th>สต๊อกหน้าร้าน</th>
							<th>ยอดนับได้</th>
							<th>รอเติม</th>
							<th>ชำรุด</th>
							<th>ขายก่อนนับ</th>
							<th>รวมนับได้</th>
							<th>ขาด/เกิน</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							<tr>
								<td>@item.ItemTypeCode</td>
								<td>@item.SubItemCode</td>
								<td>@item.ItemId</td>
								<td contenteditable="true" class="editable">@item.StoreStock</td>
								<td contenteditable="true" class="editable">@item.CountedQty</td>
								<td contenteditable="true" class="editable">@item.WaitingToRestock</td>
								<td contenteditable="true" class="editable">@item.Damaged</td>
								<td contenteditable="true" class="editable">@item.SoldBeforeCount</td>
								<td contenteditable="true" class="editable">@item.TotalCounted</td>
								<td contenteditable="true" class="editable">@item.Difference</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="text-center">
				@* <button type="button" id="btnSaveCountStock" class="btn btn-primary mt-3">Save Changes</button> *@
				<button id="btnCancel" class="btn btn-submit mt-3">ยกเลิก</button>
				<button id="btnSaveCountStock" name="btnCreate" class="btn btn-submit mt-3">
					<i class="bx bx-plus"></i>
					บันทึกข้อมูล
				</button>
			</div>
		</form>
	</div>
</div>
