@using CYRetailIMS.ComponentService.Web.Controllers
@model List<CountStockItemViewModel>

@{
	ViewData["Title"] = "CountStock";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
	var saveDataUrl = Url.Action("SaveData", "Stock");
}

