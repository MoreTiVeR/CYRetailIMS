@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
	string apiKey = @ViewBag.GoogleMapsApiKey;
}

<h2>Employee Check-In</h2>

<form id="checkInForm" method="post" action="/Attendance/CheckIn">
	<input type="hidden" id="latitude" name="Latitude" />
	<input type="hidden" id="longitude" name="Longitude" />
	<input type="text" name="EmployeeId" placeholder="Employee ID" required />
	<button type="button" onclick="getLocation()">Check In</button>
</form>

<div id="status"></div>
<div id="map" style="height: 400px; width: 100%;"></div>
<!-- Check-In Button -->
<button id="checkInButton" style="margin-top: 20px; padding: 10px 20px; font-size: 16px;">Check In</button>


