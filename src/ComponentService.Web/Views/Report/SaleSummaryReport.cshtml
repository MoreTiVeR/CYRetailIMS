@using CYRetailIMS.Application.Services.ReportService.Queries.SaleSummaryReport.v1;

@{
    ViewData["Title"] = "SaleSummaryReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
	<div class="page-title">
		<h4>รายงานสรุปยอด</h4>
		<h6>รายงานสรุปยอดสิ้นวันแบ่งตามสาขา</h6>
	</div>
</div>
<!-- /product list -->
<div class="card">
	<div class="card-body">
		<div class="table-top">
			<div class="search-set">
				<div class="search-path">
					<a class="btn btn-filter" id="filter_search">
						<img src="~/assets/img/icons/filter.svg" alt="img">
						<span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
					</a>
				</div>
				<div class="search-input">
					<a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
				</div>
			</div>
			@*<div class="wordset">
				<ul>
					<li>
						<a data-bs-toggle="tooltip" data-bs-placement="top" title="pdf"><img src="~/assets/img/icons/pdf.svg" alt="img"></a>
					</li>
					<li>
						<a data-bs-toggle="tooltip" data-bs-placement="top" title="excel"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
					</li>
				</ul>
			</div>*@
		</div>
		<!-- /Filter -->
		<div class="card" id="filter_inputs">
			<div class="card-body pb-0">
				<div class="row">
					<div class="col-lg-2 col-sm-6 col-12">
						<div class="form-group">
							<div class="input-groupicon">
								<input type="text" placeholder="From Date" class="datetimepicker">
								<div class="addonset">
									<img src="~/assets/img/icons/calendars.svg" alt="img">
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-2 col-sm-6 col-12">
						<div class="form-group">
							<div class="input-groupicon">
								<input type="text" placeholder="To Date" class="datetimepicker">
								<div class="addonset">
									<img src="~/assets/img/icons/calendars.svg" alt="img">
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-1 col-sm-6 col-12 ms-auto">
						<div class="form-group">
							<a class="btn btn-filters ms-auto"><img src="~/assets/img/icons/search-whites.svg" alt="img"></a>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /Filter -->
		<div class="table-responsive">
			<table class="table datanew">
				<thead>
					<tr>
						<th hidden>
							<label class="checkboxs">
								<input type="checkbox" id="select-all">
								<span class="checkmarks"></span>
							</label>
						</th>
						<th>วันที่</th>
						<th>สาขา</th>
						<th>ยอดเงินรวม</th>
						<th>ยอดเงินโอน</th>
						<th>ยอดเงินฝาก</th>
						<th>ยอดเงินหน้าร้าน</th>
						<th>ค่าธรรมเนียม</th>
						<th>พนักงานขาย</th>
						<th>ยอดบัญชี</th>
						<th>หมายเหตุ</th>
					</tr>
				</thead>
				<tbody>
					@if (ViewBag.SaleSummaryReportList.result)
					{
						foreach (var item in (List<SaleSummaryReportResponseDTO>)ViewBag.SaleSummaryReportList.data)
						{
							bool isAudit = item.auditid > 0 ? true : false;
							string bingingAuditCss = item.auditid > 0 ? "badges bg-lightgreen" : "badges bg-lightred";
							string rName = $"rowid{@item.transactionid}";
							Dictionary<string, string> aTransID = new Dictionary<string, string> { { "transactionid", item.transactionid.ToString() } };
							<tr>
								<td hidden>
									<label class="checkboxs">
										<input type="checkbox">
										<span class="checkmarks"></span>
									</label>
								</td>
								<td>@item.transactiondate</td>
								<td>@item.branchname</td>
								<td>@item.totalamount</td>
								<td>@item.amounttransfer</td>
								<td>@item.amountdeposit</td>
								<td>@item.amountcash</td>
								<td>@item.depositfee</td>
								<td>@item.createdbystaff</td>
								<td>
									@if (isAudit)
									{
										<span class="@bingingAuditCss">@item.totalauditamount</span>
									}
									else
									{
										<a class="me-3" asp-action="AuditSaleSummaryReport" asp-controller="Report" title="คลิก เพื่อตรวจสอบ" asp-all-route-data="aTransID">
											<span class="@bingingAuditCss">รอตรวจสอบ</span>
										</a>
									}
								</td>
								<td>@item.auditdescription</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
<!-- /product list -->
@section Scripts{

	<!--Page Script-->
	@*<script src="~/js/view/item/item_index.js" asp-append-version="true"></script>*@
}

