@using CYRetailIMS.Application.Common.Models.UI
@model EndOfDaySummaryViewModel

@{
	ViewData["Title"] = "สรุปยอดสิ้นวัน";
	Layout = "~/Views/Shared/_Layout.cshtml";

	var menu_name = "เพิ่มรายการสรุปยอดสิ้นวัน";
	var menu_desc = "เพิ่มรายการบันทึกสรุปยอดสิ้นวันใหม่";
	bool isEdit = Model != null && Model.EndOfDayId.HasValue;
}

<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/pickadate/pickadate.css">
<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/daterange/daterangepicker.css">


<style type="">
	.line-with-text {
		text-align: center;
		border-top: 1px solid #e0e0e0;
		margin: 1.5rem 0;
		position: relative;
		font-size: 16px;
	}

		.line-with-text span {
			display: inline-block;
			background: #fff; /* match page/card background */
			padding: 0 10px;
			position: relative;
			top: -0.6em;
			font-weight: 500;
		}
</style>

<div class="page-header">
	<div class="page-title">
		<h4>@menu_name</h4>
		<h6>@menu_desc</h6>
	</div>
</div>

