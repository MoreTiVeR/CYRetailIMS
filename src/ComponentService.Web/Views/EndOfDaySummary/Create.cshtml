<div class="card">
	<div class="card-body">

		@using (Html.BeginForm("CreateEodSummary", "EndOfDaySummary", FormMethod.Post, new { @class = "row" }))
		{
			@Html.AntiForgeryToken()

			@Html.ValidationSummary(true, "", new { @class = "text-danger" })

			@* Hidden for Id (for Edit reuse) *@
			@Html.HiddenFor(m => m.EndOfDayId)

			<div class="row">
				<div class="col-lg-4 col-sm-6 col-12">
					<div class="form-group">
						@Html.LabelFor(m => m.SummaryDate, new { @class = "form-label" })
						<div class="input-groupicon">
							<input id="txtSaleDate" type="text" placeholder="วันที่สรุปยอด" class="pickadate-saledate" asp-for="SummaryDate">
							<a class="addonset">
								<img src="~/assets/img/icons/calendars.svg" alt="img">
							</a>
							<span asp-validation-for="SummaryDate" class="text-danger"></span>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-md-4">
					<div class="mb-4">
						@Html.LabelFor(m => m.TotalCash, new { @class = "form-label" })
						@Html.TextBoxFor(m => m.TotalCash, new { @class = "form-control text-end", type = "number", @readonly = "readonly" })
						@Html.ValidationMessageFor(m => m.TotalCash, "", new { @class = "text-danger" })
					</div>
				</div>
				<div class="col-md-4">
					<div class="mb-4">
						@Html.LabelFor(m => m.TotalTransfer, new { @class = "form-label" })
						@Html.TextBoxFor(m => m.TotalTransfer, new { @class = "form-control text-end", type = "number", @readonly = "readonly" })
						@Html.ValidationMessageFor(m => m.TotalTransfer, "", new { @class = "text-danger" })
					</div>
				</div>
				<div class="col-md-4">
					<div class="mb-4">
						@Html.LabelFor(m => m.GrandTotal, new { @class = "form-label" })
						@Html.TextBoxFor(m => m.GrandTotal, new { @class = "form-control text-end", type = "number", @readonly = "readonly" })
						@Html.ValidationMessageFor(m => m.GrandTotal, "", new { @class = "text-danger" })
					</div>
				</div>
			</div>
			<div class="row">
			</div>

			<div class="line-with-text">
				<span>สำหรับพนักงานกรอกข้อมูล</span>
			</div>

			<div class="row">

				<div class="col-md-4">
					<div class="mb-4">
						@Html.LabelFor(m => m.DepositedCash, new { @class = "form-label" })
						@Html.TextBoxFor(m => m.DepositedCash, new { @class = "form-control text-end", type = "number", step = "0.01" })
						@Html.ValidationMessageFor(m => m.DepositedCash, "", new { @class = "text-danger" })
					</div>
				</div>
				
				<div class="col-md-4">
					<div class="mb-4">
						@Html.LabelFor(m => m.CustomerTransfer, new { @class = "form-label" })
						@Html.TextBoxFor(m => m.CustomerTransfer, new { @class = "form-control text-end", type = "number", step = "0.01" })
						@Html.ValidationMessageFor(m => m.CustomerTransfer, "", new { @class = "text-danger" })
					</div>
				</div>

				<div class="col-md-4">
					<div class="mb-4">
						@Html.LabelFor(m => m.SubstituteWage, new { @class = "form-label" })
						@Html.TextBoxFor(m => m.SubstituteWage, new { @class = "form-control text-end", type = "number", step = "0.01" })
						@Html.ValidationMessageFor(m => m.SubstituteWage, "", new { @class = "text-danger" })
					</div>
				</div>

				
			</div>

			<div class="row">

				<div class="col-md-4">
					<div class="mb-4">
						@Html.LabelFor(m => m.Fee, new { @class = "form-label" })
						@Html.TextBoxFor(m => m.Fee, new { @class = "form-control text-end", type = "number", step = "0.01" })
						@Html.ValidationMessageFor(m => m.Fee, "", new { @class = "text-danger" })
					</div>
				</div>
				
				<div class="col-md-4">
					<div class="mb-4">
						@Html.LabelFor(m => m.OtherExpense, new { @class = "form-label" })
						@Html.TextBoxFor(m => m.OtherExpense, new { @class = "form-control text-end", type = "number", step = "0.01" })
						@Html.ValidationMessageFor(m => m.OtherExpense, "", new { @class = "text-danger" })
					</div>
				</div>

				<div class="col-md-4">
					<div class="mb-4">
						@Html.LabelFor(m => m.FinalTotal, new { @class = "form-label" })
						@Html.TextBoxFor(m => m.FinalTotal, new { @class = "form-control text-end", type = "number", step = "0.01" })
						@Html.ValidationMessageFor(m => m.FinalTotal, "", new { @class = "text-danger" })
					</div>
				</div>

			</div>

			<div class="row">
				<div class="col-md-12">
					<div class="mb-3">
						@Html.LabelFor(m => m.OtherExpenseNote, new { @class = "form-label" })
						@Html.TextAreaFor(m => m.OtherExpenseNote, 3, 50, new { @class = "form-control" })
						@Html.ValidationMessageFor(m => m.OtherExpenseNote, "", new { @class = "text-danger" })
					</div>
				</div>
			</div>

			<div class="col-lg-12 text-center">
				<button type="submit" class="btn btn-submit me-2">
					<i class="fa fa-save me-1"></i> @(isEdit ? "อัปเดต" : "บันทึก")
				</button>
				<a asp-action="Index" asp-controller="EndOfDaySummary" class="btn btn-cancel me-2">
					ยกเลิก
				</a>
			</div>

		}
	</div>
</div>

@section Scripts {

	<script src="~/assets/plugins/pickers/pickadate/picker.js"></script>
	<script src="~/assets/plugins/pickers/pickadate/picker.date.js"></script>
	<script src="~/assets/plugins/pickers/pickadate/picker.time.js"></script>
	<script src="~/assets/plugins/pickers/pickadate/legacy.js"></script>
	<script src="~/lib/display-remaining-characters/jquery.charactersRemaining.min.js"></script>

	<script src="~/js/view/eodsummary/eodsummary_create.js"></script>
}