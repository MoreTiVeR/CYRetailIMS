
@{
    ViewData["Title"] = "Transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .input-group-text{
        width: 70%;
    }

    input[type="text"]:read-only {
        cursor: default;
        background-color: #ffffff;
        color: #000;
    }
</style>

<div class="page-header">
    <div class="page-title">
        <h4>โอนสินค้าเร่งด่วน</h4>
        <h6>ทำรายการโอนสินค้า</h6>
    </div>
</div>

<!-- /product list -->
<div class="card">
    <div class="card-body">
        <div class="table-top">
            <div class="search-set">
                <div class="search-path">
                    <a class="btn btn-filter" id="filter_search">
                        <img src="~/assets/img/icons/filter.svg" alt="img">
                        <span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
                    </a>
                </div>
                <div class="search-input">
                    <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
                </div>
            </div>
            @* <div class="wordset">
            <ul>
            <li>
            <a id="btnExportExcel" data-bs-toggle="tooltip" data-bs-placement="top" title="ดาวน์โหลดไฟล์ excel"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
            </li>
            </ul>
            </div>*@
        </div>
        <!-- /Filter -->
        <div class="card mb-0" id="filter_inputs">
            <div class="card-body pb-0">
                <div class="row">
                    <div class="col-lg-3 col-sm-6 col-12">
                        <div class="form-group">
                            <select id="ddlBranch" class="ddl-select2 select2 ddl-source-branch" asp-items="@(new SelectList(ViewBag.BranchList, "Value", "Text", null, null))">
                                <option value="">--เลือกสาขา--</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 col-12">
                        <select id="ddlBrand" class="ddl-select2 select2 ddl-source-brand" asp-items="@(new SelectList(ViewBag.ItemBrandList, "Value", "Text", null, null))">
                            <option value="">--เลือกแบรนด์--</option>
                        </select>
                    </div>
                    @* <div class="col-lg-3 col-sm-6 col-12">
                        <select id="ddlBrand" class="ddl-select2 select2 ddl-source-brand" asp-items="@(new SelectList(ViewBag.SubItemTypeList, "Value", "Text", null, null))">
                            <option value="">--เลือกประเภทย่อย--</option>
                        </select>
                    </div> *@
                    <div class="col-lg-3 col-sm-6 col-12">
                        <div class="form-group" style="text-align: left">
                            <a id="btnSearch" class="btn btn-filters" title="กดเพิ่อค้นหา"><img src="~/assets/img/icons/search-whites.svg" alt="img"></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-lg-4 col-12">
                <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text">จำนวน</span>
                        <input id="txtSumUserRefillQTY" type="text" class="form-control allownumericwithdecimal">
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-lg-4 col-12">
                <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text">จำนวนที่ต้องเติม</span>
                        <input id="txtSumSystemTotalRefillQTY" type="text" onkeyup="if(this.value<0){this.value= this.value * -1}" min="1" class="form-control allownumericwithdecimal">
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-lg-4 col-12"></div>
            <div class="col-lg-3 col-sm-6 col-lg-4 col-12"></div>
        </div>
        <!-- /Filter -->
        <div class="table-responsive">
            <table id="tbItemInventoryTransfer" class="table">
                <thead>
                    <tr>
                        <th>
                            <label class="checkboxs">
                                <input type="checkbox" id="select-all-items">
                                <span class="checkmarks"></span>
                            </label>
                        </th>
                        <th hidden>สาขา</th>
                        <th hidden>ไอดีสินค้า</th>
                        <th>จำนวนที่เติม</th>
                        <th>รหัสสินค้า</th>
                        <th>ชื่อสินค้า</th>
                        <th>แบรนด์</th>
                        <th>คลังคงเหลือ</th>
                        <th>คงเหลือหน้าร้าน</th>
                        <th>จำนวนขั้นต่ำ</th>
                        <th>จำนวนที่ต้องเติม</th>
                        <th hidden>จำนวนที่เติม</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-body text-center">
        <div class="form-group">
            <button id="btnCancel" type="submit" class="btn btn-cancel me-2">ยกเลิก</button>
            <button id="btnSaveDraft" type="submit" class="btn btn-submit me-2">บันทึกฉบับร่าง</button>
            <button id="btnConfirmTransfer" type="submit" class="btn btn-submit me-2">โอนสินค้า</button>
        </div>
    </div>
</div>

<!-- /product list -->
@section Scripts {

    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script type="text/javascript" charset="utf8" src="~/lib/datatable-editor-2.3.2/js/editor.dataTables.js"></script>

    <!--Page Script-->
    <script src="~/js/view/inventory/inventory_transfer.js" asp-append-version="true"></script>
}

