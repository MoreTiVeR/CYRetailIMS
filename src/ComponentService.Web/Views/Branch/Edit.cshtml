@using CYRetailIMS.Application.Common.Models.UI;

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model EditBranchViewModel

<div class="page-header">
    <div class="page-title">
        <h4>แก้ไขข้อมูลสาขา</h4>
        <h6>ปรับปรุงข้อมูลสาขา</h6>
    </div>
</div>
<!-- /add -->
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="form-group">
                <form id="frmEditBranch" class="form-edit-branch" onsubmit="return EditBrach(this)">
                    <input type="hidden" asp-for="branchid" readonly>
                    <div class="row">
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>ชื่อสาขา</label>
                                <input type="text" asp-for="branchname">
                                <span asp-validation-for="branchname" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>รหัสสาขา</label>
                                <input type="text" asp-for="branchcode">
                                <span asp-validation-for="branchcode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label>ที่อยู่สาขา</label>
                                @Html.TextAreaFor(m => m.address, new
                                {
                                @class = "form-control full-width",
                                @style = "resize: none;",
                                @cols = 5,
                                @rows = 3,
                                @maxlength = 200,
                                value = "",
                                placeholder = Html.DisplayNameFor(n => n.address)
                                })
                                <span asp-validation-for="address" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            @*<button id="btnCancel" name="btnCancel" type="reset" class="btn btn-cancel me-2">
                                <i class="bx bx-plus"></i>
                                ยกเลิก
                            </button>*@
                            <a asp-action="Index" asp-controller="Branch" class="btn btn-cancel me-2">ยกเลิก</a>
                            <button id="btnSave" name="btnSave" type="submit" class="btn btn-submit me-2">
                                <i class="bx bx-plus"></i>
                                บันทึกข้อมูล
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- /add -->
@section Scripts{

    <!--Page Script-->
    <script src="~/js/view/branch/branch_edit.js" asp-append-version="true"></script>

    <script>

    </script>
}
