@using CYRetailIMS.Application.Services.BranchService.Queries.GetBranchByID.v1;

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>สาขา</h4>
        <h6>จัดการสาขา</h6>
    </div>
    <div class="page-btn">
        <a asp-action="Create" asp-controller="Branch" class="btn btn-added"><img src="~/assets/img/icons/plus.svg" alt="img" class="me-2">เพิ่มสาขา</a>
    </div>
</div>


<!-- /branch list -->
<div class="card">
    <div class="card-body">
        <div class="table-top">
            <div class="search-set">
                <div class="search-path">
                    <a class="btn btn-filter" id="filter_search">
                        <img src="~/assets/img/icons/filter.svg" alt="img">
                        <span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
                    </a>
                </div>
                <div class="search-input">
                    <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
                </div>
            </div>
        </div>
        <!-- /Filter -->
        <!-- /Filter -->
        <div class="table-responsive">
            <input type="hidden" id="txtReportName" value="รายชื่อสาขา">
            <table id="tbBranchs" class="table">
                <thead>
                    <tr>
                        <th hidden>
                            <label class="checkboxs">
                                <input type="checkbox" id="select-all">
                                <span class="checkmarks"></span>
                            </label>
                        </th>
                        <th>รหัสสาขา</th>
                        <th>ชื่อสาขา</th>
                        <th>ที่อยู่สาขา</th>
                        <th>ดำเนินการ</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- /branch list -->
@section Scripts{

    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <!--Page Script-->
    <script src="~/js/view/branch/branch_index.js" asp-append-version="true"></script>

}
