@using CYRetailIMS.Application.Services.BranchService.Queries.GetBranchByID.v1;

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
	<div class="page-title">
		<h4>สาขา</h4>
		<h6>จัดการสาขา</h6>
	</div>
	<div class="page-btn">
		<a asp-action="Create" asp-controller="Branch" class="btn btn-added"><img src="~/assets/img/icons/plus.svg" alt="img" class="me-2">เพิ่มสาขา</a>
	</div>
</div>


<!-- /branch list -->
<div class="card">
	<div class="card-body">
		<div class="table-top">
			<div class="search-set">
				<div class="search-path">
					<a class="btn btn-filter" id="filter_search">
						<img src="~/assets/img/icons/filter.svg" alt="img">
						<span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
					</a>
				</div>
				<div class="search-input">
					<a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
				</div>
			</div>
			@*<div class="wordset">
				<ul>
					<li>
						<a id="btnExportExcel" data-bs-toggle="tooltip" data-bs-placement="top" title="ดาวน์โหลดไฟล์ excel"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
					</li>
				</ul>
			</div>*@
		</div>
		<!-- /Filter -->
		@*<div class="card" id="filter_inputs">
			<div class="card-body pb-0">
				<div class="row">
					<div class="col-lg-2 col-sm-6 col-12">
					</div>
					<div class="col-lg-2 col-sm-6 col-12">
					</div>
					<div class="col-lg-2 col-sm-6 col-12">
					</div>
					<div class="col-lg-2 col-sm-6 col-12">
					</div>
					<div class="col-lg-1 col-sm-6 col-12 ms-auto">
					</div>
				</div>
			</div>
		</div>*@
		<!-- /Filter -->
		<div class="table-responsive">
			<table id="tbItems" class="table datanew">
				<thead>
					<tr>
						<th hidden>
							<label class="checkboxs">
								<input type="checkbox" id="select-all">
								<span class="checkmarks"></span>
							</label>
						</th>
						<th>รหัสสาขา</th>
						<th>ชื่อสาขา</th>
						<th>ที่อยู่สาขา</th>
						<th>ดำเนินการ</th>
					</tr>
				</thead>
				<tbody>
					@if (ViewBag.BranchList.result)
					{
						foreach (var item in (List<GetBranchResponseDTO>)ViewBag.BranchList.data)
						{
							string rName = $"rowid{@item.branchid}";
							Dictionary<string, string> aBranchID = new Dictionary<string, string> { { "branchid", item.branchid.ToString() } };
							<tr>
								<td hidden>
									<label class="checkboxs">
										<input type="checkbox">
										<span class="checkmarks"></span>
									</label>
								</td>
								<td>@item.branchcode</td>
								<td>@item.branchname</td>
								<td>@item.address1</td>
								<td>
									<a class="me-3" asp-action="Edit" asp-controller="Branch" title="แก้ไขข้อมูลสาขา" asp-all-route-data="aBranchID">
										<img src="~/assets/img/icons/edit.svg" alt="img">
									</a>
									<a href="#" id="@rName" class="me-3" title="ลบสาขา" onclick="deleteBranch(@item.branchid)">
										<img src="~/assets/img/icons/delete.svg" alt="img">
									</a>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
<!-- /branch list -->
@section Scripts{

	<!--Page Script-->
	<script src="~/js/view/branch/branch_index.js" asp-append-version="true"></script>

	<script>

	</script>
}
