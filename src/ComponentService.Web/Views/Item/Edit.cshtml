@using CYRetailIMS.Application.Common.Models.UI;
@model EditItemViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .image-responsive {
        max-width: 100%;
        height: auto;
    }
</style>

<div class="page-header">
    <div class="page-title">
        <h4>แก้ไขข้อมูลสินค้า</h4>
        <h6>ปรับปรุงข้อูลสินค้า</h6>
    </div>
</div>

<!-- /add -->
<div class="card">
    <div class="card-body">
        <form id="frmEditItem" class="form-edit-item" onsubmit="return EditItem(this)">
            <input type="hidden" asp-for="ItemID" readonly>
            @if (!string.IsNullOrEmpty(Model.BarCodeBase64))
            {
                <div class="bar-code-view">
                    <img src="data:image/jpeg;base64,@Html.Raw(Model.BarCodeBase64)" alt="Barcode Image">
                   @* <a class="printimg">
                        <img src="../assets/img/icons/printer.svg" alt="print">
                    </a>*@
                </div>
            }
            else
            {
                <div class="bar-code-view">
                    <p>No Barcode image available</p>
                    @*<a class="printimg">
                        <img src="../assets/img/icons/printer.svg" alt="print">
                    </a>*@
                </div>
            }
            <div class="row">
                <!--ROW1-->
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>ชื่อสินค้า</label>
                        <input type="text" asp-for="Name">
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>ประเภทสินค้า</label>
                        @Html.DropDownListFor(model => model.ItemTypeID, new SelectList(ViewBag.ItemTypeList, "Value", "Text", null, null), "- เลือกประเภทสินค้า -", new { @class = "select2 form-control" })
                        <span asp-validation-for="ItemTypeID" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>แบรนด์สินค้า</label>
                        @Html.DropDownListFor(model => model.BrandID, new SelectList(ViewBag.ItemBrandList, "Value", "Text", null, null), "- เลือกแบรนด์สินค้า -", new { @class = "select2 form-control", @disabled = "disabled" })
                        <span asp-validation-for="BrandID" class="text-danger"></span>
                    </div>
                </div>

                <!--ROW2-->
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>รหัสสินค้า</label>
                        <input type="text" asp-for="ItemCode" readonly>
                        <span asp-validation-for="ItemCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>ประเภทย่อย</label>
                        @Html.DropDownListFor(model => model.SubItemTypeID, new SelectList(ViewBag.SubItemTypeList, "Value", "Text", null, null), "- เลือกประเภทย่อย -", new { @class = "select2 form-control" })
                        <span asp-validation-for="SubItemTypeID" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>บาร์โค้ดสินค้า</label>
                        <input type="text" class="form-control" asp-for="BarCode">
                    </div>
                </div>

                <!--ROW3-->                
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>จำนวนสินค้า</label>
                        @Html.EditorFor(model => model.Qty, new
                            {
                                htmlAttributes = new { @class = "form-control", @readonly = "readonly" }
                            })
                        <span asp-validation-for="Qty" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>จำนวนสินค้าขั้นต่ำ</label>
                        <input type="number" class="form-control" asp-for="NotifyMinQty">
                        <span asp-validation-for="NotifyMinQty" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>จำนวนสินค้าขั้นสูง</label>
                        <input type="number" class="form-control" asp-for="NotifyMaxQty">
                    </div>
                </div>

                <!--ROW4-->
                <div class="col-lg-12">
                    <div class="form-group">
                        <label>รายละเอียดสินค้า</label>
                        <textarea class="form-control" asp-for="Description"></textarea>
                    </div>
                </div>

                <!--ROW5-->
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>ราคาต้นทุน</label>
                        <input type="text" asp-for="Cost">
                        <span asp-validation-for="Cost" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>ราคาสินค้า</label>
                        <input type="text" asp-for="Price">
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>สถานะเปิดใช้งาน</label>
                        @{
                            bool.TryParse(Model.IsActive, out bool outIsActive);
                        }
                        <select class="select" asp-for="IsActive">
                            @if (outIsActive)
                            {
                                <option value="1" selected>ใช้งาน</option>
                                <option value="0">ไม่ใช้งาน</option>
                            }
                            else
                            {
                                <option value="1">ใช้งาน</option>
                                <option value="0" selected>ไม่ใช้งาน</option>
                            }
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-12">
                    @*<button id="btnCancel" type="reset" class="btn btn-cancel me-2">ยกเลิก</button>*@
                    <a asp-action="Index" asp-controller="Item" class="btn btn-cancel me-2">ยกเลิก</a>
                    <button id="btnAddItem" type="submit" class="btn btn-submit me-2">บันทึกข้อมูล</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- /add -->
@section Scripts{

    <!--Page Script-->
    <script src="~/js/view/item/item_edit.js" asp-append-version="true"></script>
}

