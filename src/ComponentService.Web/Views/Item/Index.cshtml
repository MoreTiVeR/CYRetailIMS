@using CYRetailIMS.Application.Services.ItemService.Queries.GetItemList.v1;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>รายการสินค้า</h4>
        <h6>จัดการรายการสินค้า</h6>
    </div>
    <div class="page-btn">
        <a asp-action="Create" asp-controller="Item" class="btn btn-added"><img src="~/assets/img/icons/plus.svg" alt="img" class="me-1">Add New Item</a>
    </div>
</div>

<!-- /product list -->
<div class="card">
    <div class="card-body">
        <div class="table-top">
            <div class="search-set">
                <div class="search-path">
                    <a class="btn btn-filter" id="filter_search">
                        <img src="~/assets/img/icons/filter.svg" alt="img">
                        <span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
                    </a>
                </div>
                <div class="search-input">
                    <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
                </div>
            </div>
            <div class="wordset">
                <ul>
                    <li>
                        <a data-bs-toggle="tooltip" data-bs-placement="top" title="pdf"><img src="~/assets/img/icons/pdf.svg" alt="img"></a>
                    </li>
                    <li>
                        <a data-bs-toggle="tooltip" data-bs-placement="top" title="excel"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
                    </li>
                    <li>
                        <a data-bs-toggle="tooltip" data-bs-placement="top" title="print"><img src="~/assets/img/icons/printer.svg" alt="img"></a>
                    </li>
                </ul>
            </div>
        </div>
        <!-- /Filter -->
        <div class="card mb-0" id="filter_inputs">
            <div class="card-body pb-0">
                <div class="row">
                    <div class="col-lg-12 col-sm-12">
                        <div class="row">
                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select class="select">
                                        <option>เลือกประเภทสินค้า</option>
                                        @if (ViewBag.ItemTypeList.result)
                                        {
                                            foreach (var item in ViewBag.ItemTypeList.data)
                                            {
                                                <option>@item.itemtypename</option>
                                            }
                                        }
                                        else
                                        {
                                            <option>--ไม่พบข้อมูล--</option>
                                        }
                                        <option>Computers</option>
                                        <option>Fruits</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select class="select">
                                        <option>เลือกแบรนด์สินค้า</option>
                                        @if (ViewBag.ItemBrandList.result)
                                        {
                                            foreach (var item in ViewBag.ItemBrandList.data)
                                            {
                                                <option>@item.brandname</option>
                                            }
                                        }
                                        else
                                        {
                                            <option>--ไม่พบข้อมูล--</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-1 col-sm-6 col-12">
                                <div class="form-group">
                                    <a class="btn btn-filters ms-auto" title="กดเพิ่อค้นหา"><img src="~/assets/img/icons/search-whites.svg" alt="img"></a>
                                </div>
                            </div>
                            <div class="col-lg col-sm-6 col-12">
                            </div>
                            <div class="col-lg col-sm-6 col-12">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /Filter -->
        <div class="table-responsive">
            <table class="table datanew">
                <thead>
                    <tr>
                        <th>
                            <label class="checkboxs">
                                <input type="checkbox" id="select-all">
                                <span class="checkmarks"></span>
                            </label>
                        </th>
                        <th>รหัสสินค้า</th>
                        <th>ชื่อสินค้า</th>
                        <th>ประเภท</th>
                        <th>แบรนด์</th>
                        <th>จำนวน</th>
                        <th>ต้นทุน</th>
                        <th>ราคาขาย</th>
                        <th>รายละเอียด</th>
                        <th>สร้างโดย</th>
                        <th>แก้ไขโดย</th>
                        <th>วันที่แก้ไข</th>
                        <th>ดำเนินการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.ItemList.result)
                    {
                        foreach (var item in (List<GetItemListResponseDTO>)ViewBag.ItemList.data)
                        {
                            string rName = $"rowid{@item.itemid}";
                            Dictionary<string, string> aItemID = new Dictionary<string, string> { { "itemid", item.itemid.ToString() } };
                            <tr>
                                <td>
                                    <label class="checkboxs">
                                        <input type="checkbox">
                                        <span class="checkmarks"></span>
                                    </label>
                                </td>
                                <td class="productimgname">
                                    <a asp-action="Detail" asp-controller="Item" asp-all-route-data="aItemID" title="คลิกเพื่อดูรายละเอียด" class="product-img">
                                        <img src="@item.itemimageurl" alt="product">
                                    </a>
                                    <a asp-action="Detail" asp-controller="Item" asp-all-route-data="aItemID">@item.name</a>
                                </td>
                                <td>@item.itemtypename</td>
                                <td>@item.itemcode</td>
                                <td>@item.brandname</td>
                                <td>@item.qty</td>
                                <td>@item.cost</td>
                                <td>@item.price</td>
                                <td>@item.description</td>
                                <td>@item.createdby</td>
                                <td>@item.updatedby</td>
                                <td>@item.updateddate</td>
                                <td>
                                    <a class="me-3" asp-action="Detail" asp-controller="Item" asp-all-route-data="aItemID">
                                        <img src="~/assets/img/icons/eye.svg" alt="img">
                                    </a>
                                    <a class="me-3" asp-action="Edit" asp-controller="Item" asp-all-route-data="aItemID">
                                        <img src="~/assets/img/icons/edit.svg" alt="img">
                                    </a>
                                    <a href="#" id="@rName" class="me-3" onclick="deleteItem(@item.itemid)">
                                        <img src="~/assets/img/icons/delete.svg" alt="img">
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- /Filter -->
        @*<div class="table-responsive">
        <table id="tbItems" class="table datanew">
        <thead>
        <tr>
        <th>
        <label class="checkboxs">
        <input type="checkbox" id="select-all">
        <span class="checkmarks"></span>
        </label>
        </th>
        <th>รหัสสินค้า</th>
        <th>ชื่อสินค้า</th>
        <th>ประเภท</th>
        <th>แบรนด์</th>
        <th>จำนวน</th>
        <th>ต้นทุน</th>
        <th>ราคาขาย</th>
        <th>รายละเอียด</th>
        <th>สร้างโดย</th>
        <th>แก้ไขโดย</th>
        <th>วันที่แก้ไข</th>
        <th>ดำเนินการ</th>
        </tr>
        </thead>
        </table>
        </div>*@
    </div>
</div>
<!-- /product list -->
@section Scripts{

    <!--Page Script-->
    <script src="~/js/view/item/item_index.js" asp-append-version="true"></script>
}