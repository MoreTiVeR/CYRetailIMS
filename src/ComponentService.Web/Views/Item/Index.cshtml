@using CYRetailIMS.Application.Services.ItemService.Queries.GetItemList.v1;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>รายการสินค้า</h4>
        <h6>จัดการรายการสินค้า</h6>
    </div>
    <div class="page-btn">
        <a asp-action="Create" asp-controller="Item" class="btn btn-added"><img src="~/assets/img/icons/plus.svg" alt="img" class="me-1">เพิ่มสินค้าใหม่</a>
    </div>
</div>

<!-- /product list -->
<div class="card">
    <div class="card-body">
        <div class="table-top">
            <div class="search-set">
                <div class="search-path">
                    <a class="btn btn-filter" id="filter_search">
                        <img src="~/assets/img/icons/filter.svg" alt="img">
                        <span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
                    </a>
                </div>
                <div class="search-input">
                    <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
                </div>
            </div>
            @* <div class="wordset">
            <ul>
            <li>
            <a id="btnExportExcel" data-bs-toggle="tooltip" data-bs-placement="top" title="ดาวน์โหลดไฟล์ excel"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
            </li>
            </ul>
            </div>*@
        </div>
        <!-- /Filter -->
        <div class="card mb-0" id="filter_inputs">
            <div class="card-body pb-0">
                <div class="row">
                    <div class="col-lg-3 col-sm-6 col-12">
                        <div class="form-group">
                            <select id="ddlBranch" class="select">
                                <option>เลือกสาขา</option>
                                @if (ViewBag.BranchList.result)
                                {
                                    foreach (var item in ViewBag.BranchList.data)
                                    {
                                        <option value="@item.branchid">@item.branchname</option>
                                    }
                                }
                                else
                                {
                                    <option value="">--ไม่พบข้อมูล--</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 col-12">
                        <div class="form-group" style="text-align: left">
                            <a id="btnSearch" class="btn btn-filters" title="กดเพิ่อค้นหา"><img src="~/assets/img/icons/search-whites.svg" alt="img"></a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 col-12">
                    </div>
                    <div class="col-lg-3 col-sm-6 col-12">
                    </div>
                </div>
            </div>
        </div>
        <!-- /Filter -->
        <div class="table-responsive">
            <table id="tbItems" class="table">
                <thead>
                    <tr>
                        <th hidden>
                            <label class="checkboxs">
                                <input type="checkbox" id="select-all">
                                <span class="checkmarks"></span>
                            </label>
                        </th>
                        <th>ดำเนินการ</th>
                        <th>รหัสสินค้า</th>
                        <th>ชื่อสินค้า</th>
                        <th>ประเภท</th>
                        <th>แบรนด์</th>
                        <th>จำนวน</th>
                        <th>ต้นทุน</th>
                        <th>ราคาขาย</th>
                        <th>จำนวนขั้นต่ำ</th>
                        <th>จำนวนสูงสุด</th>
                        <th class="text-center">รายละเอียด</th>
                        <th>สร้างโดย</th>
                        <th>วันที่สร้าง</th>
                        <th>แก้ไขโดย</th>
                        <th>วันที่แก้ไข</th>
                        <th>ดำเนินการ</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- /product list -->
@section Scripts{


    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <!--Page Script-->
    <script src="~/js/view/item/item_index.js" asp-append-version="true"></script>
}