@using CYRetailIMS.Application.Services.ItemTransferService.Queries.GetItemTransferByTransferID.v1;
@using CYRetailIMS.Application.Services.ItemTransferStatusService.Queries.GetItemTransferStatus.v1;
@using static CYRetailIMS.Application.Common.Models.EnumModel;

@{
    ViewData["Title"] = "TransferHistory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>ประวัติการโอนสินค้า</h4>
        <h6>ประวัติโอนสินค้าของแต่ละสาขา/ตามชนิดสินค้า</h6>
    </div>
    <div class="page-btn">
        <a asp-action="Transfer" asp-controller="Item" class="btn btn-added"><img src="~/assets/img/icons/plus.svg" alt="img" class="me-2">Add Transfer</a>
    </div>
</div>
<!-- /product list -->
<div class="card">
    <div class="card-body">
        <div class="table-top">
            <div class="search-set">
                <div class="search-path">
                    <a class="btn btn-filter" id="filter_search">
                        <img src="~/assets/img/icons/filter.svg" alt="img">
                        <span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
                    </a>
                </div>
                <div class="search-input">
                    <a class="btn btn-searchset">
                        <img src="~/assets/img/icons/search-white.svg" alt="img">
                    </a>
                </div>
            </div>
            @*<div class="wordset">
                <ul>
                    <li>
                        <a data-bs-toggle="tooltip" data-bs-placement="top" title="excel"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
                    </li>
                </ul>
            </div>*@
        </div>
        <!-- /Filter -->
        <div class="card" id="filter_inputs">
            <div class="card-body pb-0">
                <div class="row">
                    <div class="col-lg-2 col-sm-6 col-12">
                        <div class="form-group">
                            <input type="text" class="datetimepicker cal-icon" placeholder="Choose Date">
                        </div>
                    </div>
                    <div class="col-lg-2 col-sm-6 col-12">
                        <div class="form-group">
                            <input type="text" placeholder="Enter Reference">
                        </div>
                    </div>
                    <div class="col-lg-2 col-sm-6 col-12">
                        <div class="form-group">
                            <select class="select">
                                @if (ViewBag.ItemTransferStatus.result)
                                {
                                    <option value="" selected>-- เลือกสถานะการโอนสินค้า --</option>
                                    foreach (var item in (List<GetItemTransferStatusResponseDTO>)ViewBag.ItemTransferStatus.data)
                                    {
                                        <option value="@item.transferstatusid">@item.transferstatusname_th</option>
                                    }
                                }
                                else
                                {
                                    <option value="">-- ไม่พบข้อมูล --</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-1 col-sm-6 col-12 ms-auto">
                        <div class="form-group">
                            <a class="btn btn-filters ms-auto"><img src="~/assets/img/icons/search-whites.svg" alt="img"></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /Filter -->
        <div class="table-responsive">
            <table class="table  datanew">
                <thead>
                    <tr>
                        <th hidden>
                            <label class="checkboxs">
                                <input type="checkbox" id="select-all">
                                <span class="checkmarks"></span>
                            </label>
                        </th>
                        <th>วันที่โอน</th>
                        <th>สาขาต้นทาง</th>
                        <th>สาขาปลายทาง</th>
                        <th>ชนิดสินค้าโอน</th>
                        <th>จำนวนโอน</th>
                        <th>รายละเอียด</th>
                        <th>สถานะรับสินค้า</th>
                        <th>จำนวนรับ</th>
                        <th>จำนวนคืน</th>
                        <th>สร้างโดย</th>
                        <th>วันที่รับโอน</th>
                        <th>ผู้รับโอน</th>
                        @*<th>คำเนินการ</th>*@
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.ItemTransferHistory.result)
                    {
                        foreach (var item in (List<GetItemTransferResponseDTO>)ViewBag.ItemTransferHistory.data)
                        {
                            string rName = $"rowid{@item.transferid}";
                            Dictionary<string, string> aTransferID = new Dictionary<string, string> { { "transferid", item.transferid.ToString() } };
                            <tr>
                                <td hidden>
                                    <label class="checkboxs">
                                        <input type="checkbox">
                                        <span class="checkmarks"></span>
                                    </label>
                                </td>
                                <td>@($"{@item.createddate:dd/MM/yyyy HH:mm:ss}")</td>
                                <td>@item.sourcename</td>
                                <td>@item.destinationname</td>
                                <td>@item.itemname</td>
                                <td>@item.qty</td>
                                <td>@item.description</td>
                                <td>
                                    @if (item.transferstatusid == (int)TransferStatus.Received)
                                    {
                                        <span class="badges bg-lightgreen">
                                            @item.transferstatusname_th
                                        </span>
                                    }
                                    else if (item.transferstatusid == (int)TransferStatus.Cancel || item.transferstatusid == (int)TransferStatus.Reject)
                                    {
                                        <span class="badges bg-lightred">
                                            @item.transferstatusname_th
                                        </span>
                                    }
                                    else
                                    {
                                        <a class="me-3" asp-action="ReceiveItemTransfer" asp-controller="Item" title="คลิก เพื่อตรวจรับสินค้า" asp-all-route-data="aTransferID">
                                            <span class="badges bg-lightred">
                                                @item.transferstatusname_th
                                            </span>
                                        </a>
                                    }
                                </td>
                                <td>@item.receiveqty</td>
                                <td>@item.returnqty</td>
                                <td>@item.createdby</td>
                                <td>@($"{@item.updateddate:dd/MM/yyyy HH:mm:ss}")</td>
                                <td>@item.updatedby</td>
                                @*<td>
                                    <a class="me-3" href="edittransfer.html">
                                        <img src="~/assets/img/icons/edit.svg" alt="img">
                                    </a>
                                    <a class="me-3 confirm-text" href="javascript:void(0);">
                                        <img src="~/assets/img/icons/delete.svg" alt="img">
                                    </a>
                                </td>*@
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- /product list -->
