@using CYRetailIMS.Application.Common.Models.UI
@model ImportItemViewModel

@{
    ViewData["Title"] = "Import";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
	<div class="page-title">
		<h4>นำเข้าสินค้า</h4>
		<h6>นำเข้าสินค้าโดยไฟล์สินค้า</h6>
	</div>
</div>

<!-- /product list -->
<div class="card">
	<div class="card-body">
        @* <div class="table-top">
            <div class="search-set">
            </div>
            <div class="wordset">
                <ul>
                    <li>
                        <a id="btnExportExcel" data-bs-toggle="tooltip" data-bs-placement="top" title="ดาวน์โหลดไฟล์เทมเพลต"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
                    </li>
                </ul>
            </div>
        </div> *@
		@* <div class="requiredfield">
			<h4>แนะนำไฟล์ CSV</h4>
		</div> *@
		<div class="row">
            <div class="col-lg-3 col-sm-6 col-12"></div>
            <div class="col-lg-3 col-sm-6 col-12"></div>
            <div class="col-lg-3 col-sm-6 col-12"></div>
            <div class="col-lg-3 col-sm-6 col-12">
				<div class="form-group">
					<a id="aDownloadTemplateFile" class="btn btn-submit w-100 download">ดาวน์โหลดไฟล์เทมเพลต (*.CSV)</a>
				</div>
			</div>
            <hr />
            <div class="col-lg-3 col-sm-6 col-12">
                <div class="form-group">
                    <label>สาขา</label>
                    @Html.DropDownListFor(model => model.branchid, new SelectList(ViewBag.BranchList, "Value", "Text", null, null), "- กรุณาเลือกสาขา -", new { @class = "select2 form-control" })
                    <span asp-validation-for="branchid" class="text-danger"></span>
                </div>
            </div>

			<div class="col-lg-12">
				<div class="form-group">
					<label>	อัพโหดลด CSV ไฟล์</label>
					<div class="image-upload">
						<input id="fileUpload" type="file">
						<div class="image-uploads">
							<img src="~/assets/img/icons/upload.svg" alt="img">
                            <h4>ลากไฟล์วางที่นี่ หรือ คลิก เพื่ออัพโหลดไฟล์นำเข้าสินค้า</h4>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-12">
				<div class="form-group mb-0">
					<a asp-action="Index" asp-controller="Item" class="btn btn-cancel me-2">ยกเลิก</a>
					<button id="btnUpload" type="submit" class="btn btn-submit me-2">ตกลง</button>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- /product list -->
@section Scripts{

	<!--Page Script-->
	<script src="~/js/view/item/item_import.js" asp-append-version="true"></script>
}