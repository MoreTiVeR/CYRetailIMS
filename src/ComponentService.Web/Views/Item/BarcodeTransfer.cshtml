@using CYRetailIMS.Application.Common.Models.UI;
@model TransferItemViewModel

@{
    ViewData["Title"] = "BarcodeTransfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>โอนสินค้าผ่านบาร์โค้ด</h4>
        <h6>โอนสินค้าไปยังสาขา</h6>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="form-group">
                <form id="frmTransferItem" class="form repeater-default" asp-action="SaveBarcodeTransaferItem" asp-controller="Item" method="post"
                      data-ajax="true"
                      data-ajax-update=""
                      data-ajax-success="OnSuccess"
                      data-ajax-failure=""
                      data-ajax-begin="">
                    <!--ROW1-->
                    <div class="row">
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>ประเภทการโอนสินค้า</label>
                                <select class="ddl-select2 select2 ddl-transfertype" asp-for="transfertypeid" asp-items="@(new SelectList(ViewBag.ItemTransaferTypeList, "Value", "Text", null, null))">
                                    <option value="">-- ระบุประเภทการโอนสินค้า --</option>
                                </select>
                                <span asp-validation-for="transfertypeid" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>จากสาขา</label>
                                <select class="ddl-select2 select2 ddl-source-branch" asp-for="source_branchid" asp-items="@(new SelectList(ViewBag.BranchList, "Value", "Text", null, null))">
                                    <option value="">--เลือกสาขาต้นทาง--</option>
                                </select>
                                <span asp-validation-for="source_branchid" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>ไปยังสาขา</label>
                                <select class="ddl-select2 select2 ddl-destination-branch" asp-for="destination_branchid" asp-items="@(new SelectList(ViewBag.BranchList, "Value", "Text", null, null))">
                                    <option value="">--เลือกสาขาปลายทาง--</option>
                                </select>
                                <span asp-validation-for="destination_branchid" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                        </div>
                    </div>
                    <!--ROW2-->
                    <div class="row">
                        <form id="frmAddTransferItem" onsubmit="return AddTransferItem(this)">
                            <div class="row">
                                <div class="col-lg-9 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>บาร์ดโค้ด</label>
                                        <input id="txtBarCode" name="txtBarCode" type="text" class="form-control" autofocus>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>จำนวนสินค้า</label>
                                        <input id="txtBarCodeQty" name="txtBarCodeQty" type="number" class="form-control" value="1">
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!--ROW3-->
                    <div class="row">
                        @*<div class="col-lg-12 col-sm-12 col-12" style="text-align:right">
                            <a data-bs-toggle="modal" data-bs-target="#mdlTransferItem"><img src="~/assets/img/icons/plus-circle.svg" class="me-2" alt="img">เพิ่มรายการสินค้า</a>
                        </div>*@
                        <div class="col-lg-12 col-sm-12 col-12">
                            <div class="form-group">
                                <div class="table-responsive">
                                    <table id="tbItems" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th style="width:10%">#</th>
                                                <th style="width:30%">สินค้า</th>
                                                <th style="width:20%">จำนวนสินค้า</th>
												<th style="width:20%">สต๊อกคลังใหญ่</th>
                                                <th style="width:20%">ดำเนินการ</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!--ROW3-->
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label class="form-label">หมายเหตุ</label>
                                @Html.TextAreaFor(m => m.description, new
                                {
                                @class = "form-control full-width",
                                @style = "resize: none;",
                                @cols = 5,
                                @rows = 3,
                                @maxlength = 50,
                                value = "",
                                placeholder = Html.DisplayNameFor(n => n.description)
                                })
                                @*@Html.TextAreaFor(model => model.description, new { @class = "img-shadow", value = "" })*@
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <a asp-action="TransferHistory" asp-controller="Item" class="btn btn-cancel me-2">ยกเลิก</a>
                <button id="btnSave" name="btnSave" class="btn btn-submit me-2">
                    <i class="bx bx-plus"></i>
                    บันทึกข้อมูล
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Large Modal -->
@*<div id="mdlTransferItem" class="modal fade" aria-labelledby="mdlTransferItem" tabindex="-1" aria-hidden="true">
    <partial name="_PartialPage/_ModalPartialAddItemBarcode" />
</div>*@
@section Scripts{

    <!--charactersRemaining-->
    <script src="~/lib/display-remaining-characters/jquery.charactersRemaining.min.js"></script>

    <!--Page Script-->
    <script src="~/js/view/item/item_barcodetransfer.js" asp-append-version="true"></script>
}

