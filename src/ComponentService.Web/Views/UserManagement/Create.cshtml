@using CYRetailIMS.Application.Common.Models.UI;
@using CYRetailIMS.Application.Services.BranchService.Queries.GetBranchByID.v1;
@using CYRetailIMS.Application.Services.EmployeeService.Queries.GetEmployee.v1;
@using CYRetailIMS.Application.Services.RoleService.Queries.GetRoles.v1;
@model CreateUserViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>เพิ่มบัญชีผู้ใช้งาน</h4>
        <h6>เพิ่มข้อมูลบัญชีผู้ใช้งานระบบ</h6>
    </div>
</div>
<!-- /add -->
<div class="card">
    <div class="card-body">
        <form id="frmRegisterAccount" class="form-register-account" onsubmit="return RegisterAccount(this)">
            <div class="row">
                <div class="col-lg-3 col-sm-6 col-12">
                    <div class="form-group">
                        <label>พนักงาน</label>
                        <select class="ddl-select2 select2 ddl-employee" asp-for="EmpID">
                            @if (ViewBag.EmpList.result)
                            {
                                List<GetEmployeeResponseDTO> empList = (List<GetEmployeeResponseDTO>)ViewBag.EmpList.data;
                                if (empList.Count > 0)
                                {
                                    <option value="" selected>-- กรุณาเลือกพนักงาน --</option>
                                    foreach (var item in (List<GetEmployeeResponseDTO>)ViewBag.EmpList.data)
                                    {
                                        <option value="@item.empid">@item.firstname</option>
                                    }
                                }
                                else
                                {
                                    <option value="" selected>-- ไม่พบข้อมูล --</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="EmpID" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-12">
                    <div class="form-group">
                        <label>ชื่อบัญชี</label>
                        <input type="text" asp-for="UserName">
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-12">
                    <div class="form-group">
                        <label>รหัสผ่าน</label>
                        <div class="pass-group">
                            <input type="password" class=" pass-input" asp-for="Password">
                            <span class="fas toggle-password fa-eye-slash"></span>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-12">
                    <div class="form-group">
                        <label>สิทธิ์เข้าใช้งาน</label>
                        <select class="select" asp-for="RoleID">
                            @if (ViewBag.RoleList.result)
                            {
                                <option value="" selected>-- กรุณาเลือกสิทธิ์เข้าใช้งาน --</option>
                                foreach (var item in (List<GetRolesResponseDTO>)ViewBag.RoleList.data)
                                {
                                    <option value="@item.roleid">@item.description</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="RoleID" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 col-sm-6 col-12">
                    <div class="form-group">
                        <label>ประจำสาขา</label>
                        <select class="select2" asp-for="BranchID">
                            @if (ViewBag.BranchList.result)
                            {
                                <option value="" selected>-- กรุณาเลือกสาขา --</option>
                                foreach (var item in (List<GetBranchResponseDTO>)ViewBag.BranchList.data)
                                {
                                    <option value="@item.branchid">@item.branchname</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="BranchID" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-12">
                    <div class="form-group">
                        <label>สถานะ</label>
                        <select class="select" asp-for="IsActive">
                            <option value="1" selected>ใช้งาน</option>
                            <option value="0">ไม่ใช้งาน</option>
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-12"></div>
                <div class="col-lg-3 col-sm-6 col-12"></div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                   @* <button id="btnCancel" name="btnCancel" type="reset" class="btn btn-cancel me-2">
                        <i class="bx bx-plus"></i>
                        ยกเลิก
                    </button>*@
                    <a asp-action="Index" asp-controller="UserManagement" class="btn btn-cancel me-2">ยกเลิก</a>
                    <button id="btnSave" name="btnSave" type="submit" class="btn btn-submit me-2">
                        <i class="bx bx-plus"></i>
                        บันทึกข้อมูล
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- /add -->
@section Scripts{

    <!--Page Script-->
    <script src="~/js/view/user/user_create.js" asp-append-version="true"></script>
}