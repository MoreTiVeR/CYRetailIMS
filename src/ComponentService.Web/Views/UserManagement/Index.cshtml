				</div>
			</div>
		</div>*@
		<!-- /Filter -->
		<div class="table-responsive">
			<table id="tbUsers" class="table datanew">
				<thead>
					<tr>
						<th hidden>
							<label class="checkboxs">
								<input type="checkbox">
								<span class="checkmarks"></span>
							</label>
						</th>
						<th>ชื่อบัญชี</th>
						<th>สิทธิ์เข้าใช้งาน</th>
						<th>เข้าสู่ระบบล่าสุด</th>
						<th>ออกจากระบบล่าสุด</th>
						<th>วันที่สร้าง</th>
						<th>สถานะ</th>
						<th>ดำเนินการ</th>
					</tr>
				</thead>
				<tbody>
					@if (ViewBag.UserList.result)
					{
						foreach (var item in (List<GetUserResponseDTO>)ViewBag.UserList.data)
						{
							@*string bingingRegisterCss = item.isregister ? "badges bg-lightgreen" : "badges bg-lightred";
							string bingingRegisterName = item.isregister ? "ผูกบัญชีแล้ว" : "ยังไม่ผูกบัญชี";*@
							string userStatusCss = item.isactive ? "badges bg-lightgreen" : "badges bg-lightred";
							string userStatusName = item.isactive ? "ใช้งาน" : "ไม่ใช้งาน";
							string rName = $"rowid{item.userid}";
							Dictionary<string, string> aUserID = new Dictionary<string, string> { { "userid", item.userid.ToString() } };
							<tr>
								<td hidden>
									<label class="checkboxs">
										<input type="checkbox">
										<span class="checkmarks"></span>
									</label>
								</td>
								<td>@item.username</td>
								<td>@item.rolename</td>
								<td>@item.lastlogin</td>
								<td>@item.lastlogout</td>
								<td>@item.creadeddate</td>
								<td><span class="@userStatusCss">@userStatusName</span></td>
								<td>
									<a class="me-3" asp-action="Edit" asp-controller="UserManagement" title="แก้ไขข้อมูลบัญชีผู้ใช้งาน" asp-all-route-data="aUserID">
										<img src="~/assets/img/icons/edit.svg" alt="img">
									</a>
									<a href="#" id="@rName" class="me-3" title="ลบข้อมูลบัญชีผู้ใช้งาน" onclick="deleteUser(@item.userid)">
										<img src="~/assets/img/icons/delete.svg" alt="img">
									</a>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
