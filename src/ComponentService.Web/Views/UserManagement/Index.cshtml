    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
	<div class="page-title">
		<h4>ผู้ใช้งาน</h4>
		<h6>จัดการข้อมูลผู้ใช้งาน</h6>
	</div>
	<div class="page-btn">
		<a asp-action="Create" asp-controller="UserManagement" class="btn btn-added"><img src="~/assets/img/icons/plus.svg" alt="img">เพิ่มบัญชีผู้ใช้งาน</a>
	</div>
</div>

<!-- /product list -->
