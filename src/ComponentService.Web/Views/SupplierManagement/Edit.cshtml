@using CYRetailIMS.Application.Common.Models.UI;
@model EditSupplierViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>แก้ไขข้อมูลซัฟพลายเออร์</h4>
        <h6>ทำรายการแก้ไขข้อมูลซัฟพลายเออร์</h6>
    </div>
</div>
<!-- /add -->
<div class="card">
    <div class="card-body">
        <form id="frmEditSupplier" class="form-edit-supplier" onsubmit="return EditSupplier(this)">
            <input type="hidden" asp-for="supplierid" readonly>
            <div class="row">
                <!--ROW1-->
                <div class="row">
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ประเภทซัฟพลายเออร์</label>
                            <select class="select" asp-for="suppliertypeid">
                                @if (ViewBag.SupplierTypeList.result)
                                {
                                    <option value="">-- เลือกประเภทซัฟพลายเออร์ --</option>
                                    foreach (var item in ViewBag.SupplierTypeList.data)
                                    {
                                        <option value="@item.suppliertypeid">@item.suppliertypename</option>
                                    }
                                }
                                else
                                {
                                    <option>-- ไม่พบข้อมูล --</option>
                                }
                            </select>
                            <span asp-validation-for="suppliertypeid" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ช่องทางการติดต่อ</label>
                            <select class="select" asp-for="suppliercontacttypeid">
                                @if (ViewBag.SupplierContactTypeList.result)
                                {
                                    <option value="">-- เลือกช่องทางการติดต่อ --</option>
                                    foreach (var item in ViewBag.SupplierContactTypeList.data)
                                    {
                                        <option value="@item.suppliercontacttypeid">@item.suppliercontacttypename</option>
                                    }
                                }
                                else
                                {
                                    <option>-- ไม่พบข้อมูล --</option>
                                }
                            </select>
                            <span asp-validation-for="suppliercontacttypeid" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ชื่อซัฟพลายเออร์(ไทย)</label>
                            <input type="text" class="form-control" asp-for="suppliername_th">
                            <span asp-validation-for="suppliername_th" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ชื่อซัฟพลายเออร์(อังกฤษ)</label>
                            <input type="text" class="form-control" asp-for="suppliername_en">
                            <span asp-validation-for="suppliername_en" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <!--ROW2-->
                <div class="row">
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ชื่อบัญชี/Line/Facebook ซัฟพลายเออร์</label>
                            <input type="text" class="form-control" asp-for="contactaccountname">
                            <span asp-validation-for="contactaccountname" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ชื่อผู้ติดต่อ</label>
                            <input type="text" class="form-control" asp-for="contactperson">
                            <span asp-validation-for="contactperson" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>เบอร์ติดต่อ</label>
                            <input type="text" class="form-control" asp-for="mobileno">
                            <span asp-validation-for="mobileno" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12"></div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label>รายละเอียด</label>
                            @Html.TextAreaFor(m => m.description, new
                            {
                            @class = "form-control full-width",
                            @style = "resize: none;",
                            @cols = 5,
                            @rows = 3,
                            @maxlength = 200,
                            value = "",
                            placeholder = Html.DisplayNameFor(n => n.description)
                            })
                        </div>
                    </div>
                </div>
                <!--ROW4-->
                <div class="row">
                    <div class="col-lg-12">
                        <a asp-action="Index" asp-controller="SupplierManagement" class="btn btn-cancel me-2">ยกเลิก</a>
                        <button id="btnSaveSupplier" type="submit" class="btn btn-submit me-2">บันทึกข้อมูล</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{

    <!--Page Script-->
    <script src="~/js/view/supplier/supplier_edit.js" asp-append-version="true"></script>
}


