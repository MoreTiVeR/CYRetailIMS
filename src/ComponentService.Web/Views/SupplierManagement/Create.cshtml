@using CYRetailIMS.Application.Common.Models.UI;
@model CreateSupplierViewModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="page-header">
    <div class="page-title">
        <h4>เพิ่มข้อมูลซัฟพลายเออร์</h4>
        <h6>ทำรายการเพิ่มข้อมูลซัฟพลายเออร์</h6>
    </div>
</div>
<!-- /add -->
<div class="card">
    <div class="card-body">
        <form id="frmSaveSupplier" class="form-save-supplier" onsubmit="return SaveSupplier(this)">
            <div class="row">
                <!--ROW1-->
                <div class="row">
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ชื่อซัฟพลายเออร์</label>
                            <input type="text" class="form-control" asp-for="suppliername_th">
                            <span asp-validation-for="suppliername_th" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ชื่อผู้ติดต่อ</label>
                            <input type="text" class="form-control" asp-for="contactperson">
                            <span asp-validation-for="contactperson" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>เบอร์ติดต่อ</label>
                            <input type="text" class="form-control" asp-for="mobileno" placeholder="@Html.DisplayNameFor(w => w.mobileno)" >
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                        </div>
                    </div>
                </div>
                <!--ROW2-->
                <div class="row">
                    <div class="col-lg-3 col-sm-12 col-12">
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label>ที่อยู่</label>
                            @Html.TextAreaFor(m => m.description, new
                            {
                            @class = "form-control full-width",
                            @style = "resize: none;",
                            @cols = 5,
                            @rows = 3,
                            @maxlength = 200,
                            value = "",
                            placeholder = Html.DisplayNameFor(n => n.description)
                            })
                            <span asp-validation-for="description" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <!--ROW4-->
                <div class="row">
                    <div class="col-lg-12">
                        <a asp-action="Index" asp-controller="SupplierManagement" class="btn btn-cancel me-2">ยกเลิก</a>
                        <button id="btnSaveSupplier" type="submit" class="btn btn-submit me-2">บันทึกข้อมูล</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{

    <!--Page Script-->
    <script src="~/js/view/supplier/supplier_create.js" asp-append-version="true"></script>
}

