@using Microsoft.Extensions.Configuration
@using System.Reflection;
@inject IConfiguration Configuration
@{
    string _charset = Configuration.GetSection("AppSettings:APP_CHARSET").Get<string>();
    string _description = Configuration.GetSection("AppSettings:APP_DESCRIPTION").Get<string>();
    string _keywords = Configuration.GetSection("AppSettings:APP_DESCRIPTION").Get<string>();
    string _author = Configuration.GetSection("AppSettings:APP_DESCRIPTION").Get<string>();
    string _robots = Configuration.GetSection("AppSettings:APP_ROBOTS").Get<string>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="@_charset">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <meta name="description" content="@_description">
    <meta name="keywords" content="@_keywords">
    <meta name="author" content="@_author">
    <meta name="robots" content="@_robots">
    <title>@ViewData["Title"]</title>

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon.png">

    @*<!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">

    <!-- Datetimepicker CSS -->
    <link rel="stylesheet" href="~/assets/css/bootstrap-datetimepicker.min.css">

    <!-- animation CSS -->
    <link rel="stylesheet" href="~/assets/css/animate.css">

    <!-- Select2 CSS -->
    <link rel="stylesheet" href="~/assets/plugins/select2/css/select2.min.css">

    <!-- Datatable CSS -->
    <link rel="stylesheet" href="~/assets/css/dataTables.bootstrap4.min.css">

    <!-- Fontawesome CSS -->
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/all.min.css">

    <!-- Main CSS -->
    <link rel="stylesheet" href="~/assets/css/style.css">*@

	<link href="~/assets/css/bundle/mainlayout.css" rel="stylesheet" asp-append-version="true">

</head>

<body>
    <!--Global-loader-->
    @* <div id="global-loader">
		<!--<img src="~/assets/img/svgs/loader.svg" alt="loader">-->
		<img src="~/assets/img/icons/loader.svg" alt="loader">
    </div> *@
    <div id="global-loader">
        <div class="whirly-loader"> </div>
    </div>

    <!-- Main Wrapper -->
    <div class="main-wrapper">

        <!-- Header -->
        @Html.RenderPartialAsync("_HomeLayoutPartialPage/_HeaderPartialPage")
        <!-- Header -->
        <!-- Sidebar -->
        @Html.RenderPartialAsync("_HomeLayoutPartialPage/_MenuPartialPage")
        <!-- /Sidebar -->

        <div class="page-wrapper">
            <div class="content">
                @RenderBody()
            </div>
        </div>

    </div>
    <!-- /Main Wrapper -->
    <!-- jQuery -->
    <script src="~/assets/js/jquery-3.6.0.min.js"></script>

    <!--Jquery validate Unobtrusive-->
    <script src="~/lib/jquery-validation-1.19.5/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-ajax-unobtrusive-master/src/jquery.unobtrusive-ajax.min.js" asp-append-version="true"></script>

    <!--serializeJSON js-->
    <script src="~/lib/marioizquierdo-jquery.serializeJSON/jquery.serializejson.min.js" asp-append-version="true"></script>

    <!-- Feather Icon JS -->
    <script src="~/assets/js/feather.min.js"></script>

    <!-- Slimscroll JS -->
    <script src="~/assets/js/jquery.slimscroll.min.js"></script>

    <!-- Datatable JS -->
    <script src="~/assets/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/js/dataTables.bootstrap4.min.js"></script>

    <!-- Bootstrap Core JS -->
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>

    <!-- Chart JS -->
    <script src="~/assets/plugins/apexchart/apexcharts.min.js" asp-append-version="true"></script>
    <script src="~/assets/plugins/apexchart/chart-data.js" asp-append-version="true"></script>

    <!-- Select2 JS -->
    <script src="~/assets/plugins/select2/js/select2.min.js"></script>

    <!-- Datetimepicker JS -->
    <script src="~/assets/js/moment/moment.min.js"></script>
    <script src="~/assets/js/moment/locale/th.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>

    <!-- Sweetalert 2 -->
    <script src="~/assets/plugins/sweetalert/sweetalert2.all.min.js"></script>
    <script src="~/assets/plugins/sweetalert/sweetalerts.min.js"></script>

    <!-- Toastr -->
    <script src="~/assets/plugins/toastr/toastr.min.js" asp-append-version="true"></script>
    <script src="~/assets/plugins/toastr/toastr.js" asp-append-version="true"></script>

    <!-- Custom JS -->
    <script src="~/assets/js/script.js"></script>

    <!--Site-->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>