@using CYRetailIMS.Application.Common.Models.UI;
@using CYRetailIMS.Application.Common.Models;
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
	string userprofileJson = HttpContextAccessor.HttpContext.Session.GetString("userprofile");
	UserProfileViewModel userProfile = JsonConvert.DeserializeObject<UserProfileViewModel>(userprofileJson);
}
<div class="sidebar" id="sidebar">
	<div class="sidebar-inner slimscroll">
		<div id="sidebar-menu" class="sidebar-menu">
			<ul>
				<li class="submenu-open">
					<h6 class="submenu-hdr">หน้าหลัก</h6>
					<ul>
						<li class="active">
							<a asp-action="Index" asp-controller="Home"><i data-feather="grid"></i><span>สรุปภาพรวม</span></a>
						</li>
					</ul>
				</li>
				<li class="submenu-open">
					<h6 class="submenu-hdr">เมนู</h6>
					<ul>
						@if (userProfile?.access_menu is not null)
						{
							foreach (var menu in userProfile.access_menu)
							{
								<li class="submenu">
									<a href="javascript:void(0);"><i data-feather="@menu.cms_icon_name"></i><span>@menu.menuname_th</span><span class="menu-arrow"></span></a>
									<ul>
										@if (menu.submenulist is not null)
										{
											foreach (var submenu in menu.submenulist)
											{
												<li><a asp-controller="@submenu.cms_controllername" asp-action="@submenu.cms_actionname" title="@submenu.description">@submenu.menuname_th</a></li>
											}
										}
									</ul>
								</li>
							}
						}
					</ul>
				</li>
				<li class="submenu-open">
					<h6 class="submenu-hdr">ตั้งค่า</h6>
					<ul>
						<li>
							<a asp-controller="Account" asp-action="Logout"><i data-feather="log-out"></i><span>ออกจากระบบ</span> </a>
						</li>
					</ul>
				</li>
			</ul>
		</div>
	</div>
</div>