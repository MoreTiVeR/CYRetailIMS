@using CYRetailIMS.Application.Common.Models.UI;
@model AdjustItemViewModel

<!-- show payment Modal -->
<form id="frmAddAdjustItem" onsubmit="return AddAdjustItem(this)">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">เพิ่มสินค้าปรับสต๊อก</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>สาขา</label>
                            <select class="select" asp-for="nbranchid">
                                @if (ViewBag.BranchList.result)
                                {
                                    <option value="">--เลือกสาขา-</option>
                                    foreach (var item in ViewBag.BranchList.data)
                                    {
                                        <option value="@item.branchid">@item.branchname</option>
                                    }
                                }
                                else
                                {
                                    <option>--ไม่พบข้อมูลสาขา--</option>
                                }
                            </select>
                            <span asp-validation-for="nbranchid" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ปรับเภทการปรับสต๊อก</label>
                            <select class="select" asp-for="nadjusttypeid">
                                @if (ViewBag.AdjustItemType.result)
                                {
                                    <option value="">--เลือกประเภทปรับสต๊อก--</option>
                                    foreach (var item in ViewBag.AdjustItemType.data)
                                    {
                                        <option value="@item.adjusttypeid">@item.adjusttypename</option>
                                    }
                                }
                                else
                                {
                                    <option>--ไม่พบข้อมูลประเภทปรับสต๊อก--</option>
                                }
                            </select>
                            <span asp-validation-for="nadjusttypeid" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>สินค้า</label>
                            <select class="select" asp-for="nitemid">
                                @if (ViewBag.ItemList.result)
                                {
                                    <option value="">--เลือกสินค้า--</option>
                                    foreach (var item in ViewBag.ItemList.data)
                                    {
                                        <option value="@item.itemid">@item.name</option>
                                    }
                                }
                                else
                                {
                                    <option>--ไม่พบข้อมูลสินค้า--</option>
                                }
                            </select>
                            <span asp-validation-for="nitemid" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>จำนวนสินค้า</label>
                            <input type="number" class="form-control" asp-for="nqty">
                            <span asp-validation-for="nqty" class="text-danger"></span>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-submit">Submit</button>
            </div>
        </div>
    </div>
</form>
<!-- show payment Modal -->
