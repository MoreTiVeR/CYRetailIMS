        <div class="table-responsive">
            <table class="table datanew">
                <thead>
                    <tr>
                        <th hidden>
                            <label class="checkboxs">
                                <input type="checkbox" id="select-all">
                                <span class="checkmarks"></span>
                            </label>
                        </th>
                        <th>วันที่ทำรายการ</th>
                        <th>สาขา</th>
                        <th>ยอดเงินรวม</th>
                        <th>เงินโอน</th>
                        <th>เงินฝาก</th>
                        <th>เงินหน้าร้าน</th>
                        <th>ผู้ทำรายการ</th>
                        <th class="text-center">ดำเนินการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.TransactionList.result)
                    {
                        foreach (var item in (List<GetTransactionByBranchIDResponseDTO>)ViewBag.TransactionList.data)
                        {
                            <tr>
                                <td hidden>
                                    <label class="checkboxs">
                                        <input type="checkbox">
                                        <span class="checkmarks"></span>
                                    </label>
                                </td>
                                <td>@($"{@item.transactiondate:dd/MM/yyyy HH:mm:ss}")</td>
                                <td><span class="badges bg-lightgreen">@item.branchname</span></td>
                                <td>@item.totalamount</td>
                                <td>@item.amounttransfer</td>
                                <td>@item.amountdeposit</td>
                                <td>@item.amountcash</td>
                                <td>@item.createdbystaff</td>
