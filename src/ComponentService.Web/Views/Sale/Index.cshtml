@using CYRetailIMS.Application.Services.ItemInBranchService.Queries.GetItemInBranchByBranchID.v1;
@using CYRetailIMS.Application.Services.ItemInBranchService.Queries.GetItemInBranchByBranchList.v1;
@using CYRetailIMS.Application.Services.TransactionService.Queries.GetTransactionByBranchID.v1;
@using static CYRetailIMS.Application.Common.Models.EnumModel
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
	<div class="page-title">
		<h4>รายการขายสินค้า</h4>
		<h6>ประวัติการขายสินค้า</h6>
	</div>
	<div class="page-btn">
		<a asp-action="Create" asp-controller="Sale" class="btn btn-added"><img src="~/assets/img/icons/plus.svg" alt="img" class="me-1">เพิ่มรายการขายใหม่</a>
	</div>
</div>
<div class="card">
	<div class="card-body">
		<div class="table-top">
			<div class="search-set">
				<div class="search-path">
					<a class="btn btn-filter" id="filter_search">
						<img src="~/assets/img/icons/filter.svg" alt="img">
						<span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
					</a>
				</div>
				<div class="search-input">
					<a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
				</div>
			</div>
			@*<div class="wordset">
                <ul>
                    <li>
                        <a id="btnExportExcel" data-bs-toggle="tooltip" data-bs-placement="top" title="ดาวน์โหลดไฟล์ excel"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
                    </li>
                </ul>
            </div>*@
		</div>
		<!-- /Filter -->
		<div class="card" id="filter_inputs">
			<div class="card-body pb-0">
				<div class="row">
					<div class="col-lg-3 col-sm-6 col-12">
						<div class="form-group">
							<div class="input-groupicon">
								<input id="txtStartDate" type="text" placeholder="จากวันที่" class="datetimepicker">
								<div class="addonset">
									<img src="~/assets/img/icons/calendars.svg" alt="img">
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-6 col-12">
						<div class="form-group">
							<div class="input-groupicon">
								<input id="txtEndDate" type="text" placeholder="ถึงวันที่" class="datetimepicker">
								<div class="addonset">
									<img src="~/assets/img/icons/calendars.svg" alt="img">
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-sm-6 col-12">
						<div class="form-group" style="text-align: left">
							<a id="btnSearch" class="btn btn-filters" title="กดเพิ่อค้นหา"><img src="~/assets/img/icons/search-whites.svg" alt="img"></a>
						</div>
					</div>
					<div class="col-lg-3 col-sm-6 col-12">
					</div>
				</div>
			</div>
		</div>
		<!-- /Filter -->
		<div class="table-responsive">
			<table id="tbSaleTransaction" class="table">
				<thead>
					<tr>
						<th hidden>
							<label class="checkboxs">
								<input type="checkbox" id="select-all">
								<span class="checkmarks"></span>
							</label>
						</th>
						<th>วันที่ทำรายการ</th>
						<th>สาขา</th>
						<th>ช่องทางการขาย</th>
						<th>ยอดเงินรวม</th>
						<th>เงินโอน</th>
						<th>เงินฝาก</th>
						<th>ค่าแรงวันหยุด</th>
						<th>หมายเหตุ</th>
						<th>ผู้ทำรายการ</th>
						<th class="text-center">ดำเนินการ</th>
					</tr>
				</thead>
				<tbody>
				</tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {

		<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
		<script type="text/javascript" charset="utf8" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
		<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>


		<!--Page Script-->
		<script src="~/js/view/sale/sale_index.js" asp-append-version="true"></script>
	@* <script src="~/js/view/transactions/transaction_delete.js" asp-append-version="true"></script> *@

}