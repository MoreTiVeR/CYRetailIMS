@using CYRetailIMS.Application.Common.Models.UI
@using Microsoft.AspNetCore.Http;
@using Newtonsoft.Json
@using static CYRetailIMS.Application.Common.Models.EnumModel
@model SellingItemViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
@{
	ViewData["Title"] = "Barcode";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
	string userprofileJson = HttpContextAccessor.HttpContext.Session.GetString("userprofile");
	UserProfileViewModel userProfile = JsonConvert.DeserializeObject<UserProfileViewModel>(userprofileJson);

	// Serialize the role id to make sure it's a valid JavaScript string
	ViewBag.CurrentRoleID = JsonConvert.SerializeObject(userProfile.roleid);
}

<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/pickadate/pickadate.css">
<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/daterange/daterangepicker.css">
<style type="text/css">
	/* Modal ขนาดใหญ่และกลางจอ */
	.modal-lg {
		max-width: 500px; /* ปรับขนาดตามตัวอย่าง */
	}

	.modal-content {
		border-radius: 10px;
		padding: 15px;
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		background-color: #ffffff;
		color: #333333;
	}

	/* Header */
	.modal-header {
		border-bottom: none;
		justify-content: center;
		padding-bottom: 0;
	}

	.modal-title {
		font-weight: 600;
		font-size: 1.2rem;
	}

	/* Close button */
	.modal-header .btn-close {
		position: absolute;
		right: 15px;
		top: 15px;
	}

	/* Logo section */
	.modal-body .text-center.mb-3 img {
		margin-bottom: 5px;
	}

	.modal-body .text-center h6 {
		margin: 5px 0 0 0;
		font-weight: 600;
		font-size: 1rem;
	}

	.modal-body .text-center p {
		margin: 2px 0;
		font-size: 0.85rem;
	}

	/* Invoice Info */
	.modal-body .row.mb-3 p {
		margin: 0;
		font-size: 0.85rem;
	}

	/* Table */
	.table {
		margin-bottom: 0;
		font-size: 0.85rem;
	}

		.table th, .table td {
			padding: 0.25rem 0.5rem;
		}

		.table th {
			border-bottom: 1px dashed #ccc;
			font-weight: 600;
		}

		.table td {
			border-top: 0;
		}

			/* Summary table */
			.table td.text-end {
				text-align: right;
			}

	/* Footer */
	.modal-body .text-center.mt-3 {
		font-size: 0.8rem;
		margin-top: 10px;
	}

		.modal-body .text-center.mt-3 p {
			margin: 5px 0;
		}

		.modal-body .text-center.mt-3 img {
			width: 158px;
			height: 55px;
			margin: 5px 0;
		}

	/* Print Button */
	.modal-footer {
		border-top: none;
		justify-content: center;
		padding-top: 10px;
	}

		.modal-footer .btn-primary {
			background-color: #ff8c42;
			border: none;
			padding: 8px 25px;
			font-size: 0.9rem;
			font-weight: 600;
			border-radius: 5px;
		}

		.modal-footer .btn-secondary {
			display: block; /* ปิดปุ่ม Close ถ้าไม่ต้องการ */
		}

	.hr-with-text {
		display: flex;
		align-items: center;
		text-align: center;
		color: #555;
		margin: 20px 0;
		font-size: 20px;
	}

		.hr-with-text::before,
		.hr-with-text::after {
			content: "";
			flex: 1;
			border-bottom: 1px dashed #555; /* เส้นประ */
		}

		.hr-with-text::before {
			margin-right: 10px;
		}

		.hr-with-text::after {
			margin-left: 10px;
		}

	.hr-receive {
		width: auto;
		min-width: auto;
		border-top: 1px dashed #5B6670;
	}

	.text-end {
		text-align: right !important;
	}

	/* Specific barcode style */
	.modal-body .text-center img.barcode {
		max-width: 200px; /* adjust as needed */
		height: auto;
	}
</style>

<div class="page-header">
	<div class="page-title">
		<h4>สแกนขายสินค้า</h4>
		<h6>บันทึกรายการขาย</h6>
	</div>
</div>

<div class="card">
	<div class="card-body">
		<div class="row">
			<div class="form-group">
				<input type="hidden" id="uRoleID" value="@ViewBag.CurrentRoleID" readonly />
				<form id="frmSelling" class="form" asp-action="SaveSellingItemByBarcode" asp-controller="Sale" method="post"
					  data-ajax="true"
					  data-ajax-update=""
					  data-ajax-success="OnSuccess"
					  data-ajax-failure=""
					  data-ajax-begin="">
					<div class="row">
						<div class="col-lg-5 col-sm-6 col-12">
							<div class="form-group">
								<label>สาขา</label>
								<div class="row">
									<div class="col-lg-12 col-sm-10 col-12">
										<select id="ddlBranch" class="form-control select2 ddl-ddlBranch" asp-for="branch">
											@if (userProfile.access_branch is not null)
											{
												foreach (var branch in userProfile.access_branch)
												{
													<option value="@branch.branchid">@branch.branchname</option>
												}
											}
											else
											{
												<option value="">-- ไม่พบสาขา --</option>
											}
										</select>
									</div>
									<span asp-validation-for="branch" class="text-danger"></span>
								</div>
							</div>
						</div>
						<div class="col-lg-4 col-sm-6 col-12">
							<div class="form-group">
								<label>วันที่ขาย</label>
								<div class="input-groupicon">
									<input id="txtSaleDate" type="text" placeholder="กรุณาเลือกวันที่ขายสินค้า" class="pickadate-saledate" asp-for="saledate">
									<a class="addonset">
										<img src="~/assets/img/icons/calendars.svg" alt="img">
									</a>
									<span asp-validation-for="saledate" class="text-danger"></span>
								</div>
							</div>
						</div>
						<div class="col-lg-3 col-sm-6 col-12 ">
							<div class="form-group">
								<label>รวมเงินทั้งหมด :</label>
								<div class="input-group">
									<input type="number" id="txtSummaryTHB" name="txtSummaryTHB" asp-for="amount" class="form-control" placeholder="รวมเงิน" readonly aria-label="จำนวนเงิน (บาท)" value="0.00">
									<div class="input-group-append">
										<span class="input-group-text">THB</span>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!--Scann input-->
					<div class="row">
						<div class="col-lg-12 col-sm-6 col-12">
							<div class="form-group">
								<label>บาร์โค้ด</label>
								<div class="input-group">
									<input id="txtBarCode" name="txtBarCode" type="text" class="form-control" placeholder="กรุณาสแกนขายสินค้าด้วยเครื่องอ่านบาร์โค้ด" autofocus />
									<span class="input-group-text" style="display: flex; align-items: center;">
										<img src="~/assets/img/icons/qrcode-scan.svg" alt="สแกนบาร์โค้ด" title="สแกนบาร์โค้ด" style="height: 20px; width: auto; margin: 0;" />
									</span>
								</div>
							</div>
						</div>
					</div>

					<!--Desiplay items-->
					<div class="table-responsive no-pagination">
						<table id="tbItems" class="table table-striped table-bordered">
							<thead>
								<tr>
									<th style="width:10%">#</th>
									<th hidden>รหัสสินค้า</th>
									<th style="width:30%">ชื่อสินค้า</th>
									<th style="width:20%">จำนวนสินค้า</th>
									<th style="width:20%">ราคา</th>
									<th style="width:20%">ดำเนินการ</th>
								</tr>
							</thead>
						</table>
					</div>

					@if (userProfile.roleid == (int)UserRole.Admin || userProfile.roleid == (int)UserRole.Stock){
						@await Html.PartialAsync("_PartialPage/_SellingBarcodePartialPage")
					}

				</form>
			</div>
		</div>
		<div class="row">
			<div class="col-lg-12 text-center">
				<a asp-action="Index" asp-controller="Sale" class="btn btn-cancel me-2">ยกเลิก</a>
				<button id="btnSave" name="btnSave" class="btn btn-submit me-2">
					<i class="bx bx-plus"></i>
					บันทึกข้อมูล
				</button>
			</div>
		</div>
	</div>
</div>


@section Scripts {

	<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
