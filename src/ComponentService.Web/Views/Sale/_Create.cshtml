@using CYRetailIMS.Application.Common.Models.UI;
@using CYRetailIMS.Application.Services.ItemInBranchService.Queries.GetItemInBranchByBranchID.v1;
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    string userprofileJson = HttpContextAccessor.HttpContext.Session.GetString("userprofile");
    UserProfileViewModel userProfile = JsonConvert.DeserializeObject<UserProfileViewModel>(userprofileJson);
}

<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/pickadate/pickadate.css">
<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/daterange/daterangepicker.css">

<div class="page-header">
    <div class="page-title">
        <h4>ขายสินค้า</h4>
        <h6>บันทึกรายการขาย</h6>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div class="row">
            <form id="frmSelling" class="form repeater-default" asp-action="SaveSellingItem" asp-controller="Sale" method="post"
                  data-ajax="true"
                  data-ajax-update=""
                  data-ajax-success="OnSuccess"
                  data-ajax-failure=""
                  data-ajax-begin="">
                <div id="divSellingItem">
                </div>
                <div class="form-group">
                    <div class="col p-0">
                        <button id="btnAdd" class="btn btn-primary" data-repeater-create type="button">
                            <i class="bx bx-plus"></i>
                            Add
                        </button>
                    </div>
                </div>
            </form>
            <div class="text-right">
                <button id="btnSave" name="btnSave" class="btn btn-primary">
                    <i class="bx bx-plus"></i>
                    บันทึกข้อมูล
                </button>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-12">
                <div class="form-group">
                    <label>สาขา</label>
                    <div class="row">
                        <div class="col-lg-10 col-sm-10 col-10">
                            <select id="ddlBranch" class="select">
                                @if (userProfile.access_branch is not null)
                                {
                                    foreach (var branch in userProfile.access_branch)
                                    {
                                        <option value="@branch.branchid">@branch.branchname</option>
                                    }
                                }
                                else
                                {
                                    <option value="">-- ไม่พบสาขา --</option>
                                }

                            </select>
                        </div>
                        <div class="col-lg-2 col-sm-2 col-2 ps-0">
                            <div class="add-icon">
                                <span><img src="~/assets/img/icons/plus1.svg" alt="img"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-12">
                <div class="form-group">
                    <label>วันที่ขาย</label>
                    <div class="input-groupicon">
                        <input id="txtSaleDate" type="text" placeholder="กรุณาเลือกวันที่ขายสินค้า" class="pickadate-saledate">
                        <a class="addonset">
                            <img src="~/assets/img/icons/calendars.svg" alt="img">
                        </a>
                    </div>
                </div>
            </div>
            @* <div class="col-lg-12 col-sm-6 col-12">
            <div class="form-group">
            <label>เลือกสินค้าขายออก</label>
            <div class="input-groupicon">
            <input id="txtItem" type="text" placeholder="พิมพ์ชื่อ หรือ รหัสสินค้า ที่ต้องการขาย แล้วกดเลือกรายการ...">
