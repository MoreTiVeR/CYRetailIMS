                                {
                                    foreach (var item in ViewBag.ItemInBranch as List<GetItemInBranchByBranchIDItemResponseDTO>)
                                    {
                                        <option value="@item.itemid">@item.brandname | @item.itemname</option>
                                    }
                                }
                                @*<option selected="selected">orange</option>
