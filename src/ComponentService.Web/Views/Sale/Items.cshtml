@using CYRetailIMS.Application.Services.ItemInBranchService.Queries.GetItemInBranchByBranchID.v1;

@{
    ViewData["Title"] = "Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>สินค้าหน้าร้าน</h4>
        <h6>รายการสินค้าหน้าร้าน</h6>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div class="table-top">
            <div class="search-set">
                <div class="search-path">
                    <a class="btn btn-filter" id="filter_search">
                        <img src="~/assets/img/icons/filter.svg" alt="img">
                        <span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
                    </a>
                </div>
                <div class="search-input">
                    <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
                </div>
            </div>
            <div class="wordset">
                <ul>
                    <li>
                        <a id="btnExportExcel" data-bs-toggle="tooltip" data-bs-placement="top" title="ดาวน์โหลดไฟล์ excel"><img src="~/assets/img/icons/excel.svg" alt="img"></a>
                    </li>
                </ul>
            </div>
        </div>
        <!-- /Filter -->
        <div class="card mb-0" id="filter_inputs">
            <div class="card-body pb-0">
                <div class="row">
                    <div class="col-lg-12 col-sm-12">
                        <div class="row">
                            <div class="col-lg col-sm-3 col-12">
                                <div class="form-group">
                                    <select id="ddlItemType" class="select">
                                        <option>เลือกสาขา</option>
                                        @if (ViewBag.BranchList != null)
                                        {
                                            foreach (var item in ViewBag.BranchList)
                                            {
                                                <option value="@item.branchid">@item.branchname</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="">--ไม่พบข้อมูล--</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-1 col-sm-6 col-12">
                                <div class="form-group">
                                    <a id="btnSearch" class="btn btn-filters ms-auto" title="กดเพิ่อค้นหา"><img src="~/assets/img/icons/search-whites.svg" alt="img"></a>
                                </div>
                            </div>
                            <div class="col-lg col-sm-6 col-12">
                            </div>
                            <div class="col-lg col-sm-6 col-12">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /Filter -->
        <div class="table-responsive">
            <table id="tbItems" class="table datanew">
                <thead>
                    <tr>
                        <th hidden>
                            <label class="checkboxs">
                                <input type="checkbox" id="select-all">
                                <span class="checkmarks"></span>
                            </label>
                        </th>
                        @*<th>สาขา</th>*@
                        <th>รหัสสินค้า</th>
                        <th>ชื่อสินค้า</th>
                        <th>ประเภท</th>
                        <th>แบรนด์</th>
                        <th>จำนวน</th>
                        <th>ราคา</th>
                        <th>รายละเอียด</th>
                        <th class="text-center">แก้ไข</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.ItemBranch.result)
                    {
                        string branchName = ViewBag.ItemBranch.data.branchname;
                        foreach (var item in (List<GetItemInBranchByBranchIDItemResponseDTO>)ViewBag.ItemBranch.data.itemlist)
                        {
                            string rName = $"rowid{@item.itemid}";
                            Dictionary<string, string> aItemID = new Dictionary<string, string> { { "itemid", item.itemid.ToString() } };
                            <tr>
                                <td hidden>
                                    <label class="checkboxs">
                                        <input type="checkbox">
                                        <span class="checkmarks"></span>
                                    </label>
                                </td>
                                @*<td>@branchName</td>*@
                                <td>@item.itemcode</td>
                                <td><span class="badges bg-lightgreen">@item.itemname</span></td>
                                <td>@item.itemtypename</td>
                                <td>@item.brandname</td>
                                <td><span class="badges bg-lightgreen">@item.qty</span></td>
                                <td><span class="badges bg-lightgreen">@item.price</span></td>
                                <td>@item.description</td>
                                <td class="text-center">
                                    <a class="me-3" asp-action="Edit" asp-controller="Sale" title="แก้ไขข้อมูลสินค้า" asp-all-route-data="aItemID">
                                        <img src="~/assets/img/icons/edit.svg" alt="img">
                                        @*<span class="fe fe-edit"></span>*@
                                    </a>
                                    <a class="me-3" asp-action="Edit" asp-controller="Sale" title="รับโอนสินค้า" asp-all-route-data="aItemID">
                                        <img src="~/assets/img/icons/transfer1.svg" alt="img">
                                        @*<span class="fe fe-truck"></span>*@
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts{

    <!--Page Script-->
    <script src="~/js/view/sale/sale_index.js" asp-append-version="true"></script>
}
