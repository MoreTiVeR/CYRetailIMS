@using CYRetailIMS.Application.Common.Models.UI;
@using CYRetailIMS.Application.Services.ItemInBranchService.Queries.GetItemInBranchByBranchID.v1;
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    string userprofileJson = HttpContextAccessor.HttpContext.Session.GetString("userprofile");
    UserProfileViewModel userProfile = JsonConvert.DeserializeObject<UserProfileViewModel>(userprofileJson);
}
@model SellingItemViewModel

<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/pickadate/pickadate.css">
<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/daterange/daterangepicker.css">

<div class="page-header">
    <div class="page-title">
        <h4>ขายสินค้า</h4>
        <h6>บันทึกรายการขาย</h6>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="form-group">
                <form id="frmSelling" class="form repeater-default" asp-action="SaveSellingItem" asp-controller="Sale" method="post"
                      data-ajax="true"
                      data-ajax-update=""
                      data-ajax-success="OnSuccess"
                      data-ajax-failure=""
                      data-ajax-begin="">
                    <div class="row">
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>สาขา</label>
                                <div class="row">
                                    <div class="col-lg-12 col-sm-10 col-12">
                                        <select id="ddlBranch" class="form-control select2 ddl-ddlBranch" asp-for="branch">
                                            @if (userProfile.access_branch is not null)
                                            {
                                                foreach (var branch in userProfile.access_branch)
                                                {
                                                   <option value="@branch.branchid">@branch.branchname</option>
                                                }
                                            }
                                            else
                                            {
                                                <option value="">-- ไม่พบสาขา --</option>
                                            }
                                        </select>
                                    </div>
                                    <span asp-validation-for="branch" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>วันที่ขาย</label>
                                <div class="input-groupicon">
                                    <input id="txtSaleDate" type="text" placeholder="กรุณาเลือกวันที่ขายสินค้า" class="pickadate-saledate" asp-for="saledate">
                                    <a class="addonset">
                                        <img src="~/assets/img/icons/calendars.svg" alt="img">
                                    </a>
                                    <span asp-validation-for="saledate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12 ">
                            <div class="form-group">
                                <label>รวมเงินทั้งหมด :</label>
                                <div class="input-group">
                                    <input type="number" id="txtSummaryTHB" name="txtSummaryTHB" asp-for="amount" class="form-control" placeholder="รวมเงิน" readonly aria-label="จำนวนเงิน (บาท)" value="0.00" asp-for="amount">
                                    <div class="input-group-append">
                                        <span class="input-group-text">THB</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row" id="divSellingItem">
                        <input id="totalrow" name="totalrow" value="1" hidden />
                        <div data-repeater-list="outer-item-group" class="outer-item-group">
                            <div data-repeater-item class="outer-item-group item-sale-repeater">
                                <div class="row justify-content-between">
                                    <div class="col-md-2 col-sm-12 form-group">
                                        <div class="position-relative has-icon-left search-box">
                                            <select id="ddlSearchItem" name="ddlSearchItem" onchange="return CalculatePriceByKey(this.value, this.name)" class="ddl-select2 select2 ddl-searchitem">
                                                @if (ViewBag.ItemInBranch.result)
                                                {
                                                    GetItemInBranchByBranchIDResponseDTO itemBranch = ViewBag.ItemInBranch.data;
                                                    <option value="">-- เลือกสินค้าขาย --</option>
                                                    foreach (var item in itemBranch.itemlist)
                                                    {
                                                        <option value="@item.itemid">[@item.itemcode]@item.itemname</option>
                                                    }
                                                }
                                                else
                                                {
                                                    <option value="">-- ไม่พบข้อมูล --</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-12 form-group">
                                        <div class="position-relative has-icon-left">
                                            <input type="number" id="txtItemPrice" name="txtItemPrice" onchange="return CalculatePriceByPrice(this.value, this.name)" class="form-control" placeholder="ราคาขายสินค้า" readonly>
                                            <div class="form-control-position">
                                                <i class="bx bxs-keyboard"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-12 form-group">
                                        <div class="position-relative has-icon-left">
                                            <input type="number" id="txtCurrentQty" name="txtCurrentQty" class="form-control" placeholder="จำนวนคงเหลือ" readonly>
                                            <div class="form-control-position">
                                                <i class="bx bxs-keyboard"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-12 form-group">
                                        <div class="position-relative has-icon-left">
                                            <input type="number" id="txtItemQty" name="txtItemQty" onchange="return CalculatePriceByQty(this.value, this.name)" class="form-control" placeholder="ระบุจำนวนขาย">
                                            <div class="form-control-position">
                                                <i class="bx bx-money"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-12 form-group">
                                        <fieldset>
                                            <div class="input-group">
                                                <input type="number" id="txtAmount" name="txtAmount" class="form-control" placeholder="รวมเงิน" aria-label="จำนวนเงิน (บาท)" readonly>
                                                <div class="input-group-append">
                                                    <span class="input-group-text">THB</span>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                    <div class="col-md-2 col-sm-12 form-group">
                                        <button id="btnDeleteRow" class="btn btn-danger text-nowrap" data-repeater-delete type="button">
                                            <i class="fe fe-x"></i>
                                            ลบรายการ
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-lg-12 col-sm-12 col-12">
                            <button id="btnAdd" class="btn btn-primary" data-repeater-create type="button">
                                <i class="fe fe-plus"></i>
                                เพิ่มรายการใหม่
                            </button>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>ยอดเงินโอน</label>
                                <div class="input-group">
                                    @*<input type="text" asp-for="mtransfer" class="form-control allownumericwithdecimal" onchange="return CalculateTotalAmount(this.value, this.name)" aria-label="Amount (to the nearest dollar)">*@
                                    <input type="text" asp-for="mtransfer" class="form-control allownumericwithdecimal" onchange="return CalculateTotalAmount(this.value, this.name)" aria-label="Amount (to the nearest dollar)">
                                    <span class="input-group-text">บาท</span>
                                </div>
                                <span asp-validation-for="mtransfer" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>ยอดเงินฝาก</label>
                                <div class="input-group">
                                    <input type="text" asp-for="mdeposit" class="form-control allownumericwithdecimal" aria-label="Amount (to the nearest dollar)">
                                    <span class="input-group-text">บาท</span>
                                </div>
                                <span asp-validation-for="mdeposit" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>ค่าธรรมเนียม</label>
                                <div class="input-group">
                                    <input type="text" asp-for="mfee" class="form-control allownumericwithdecimal" aria-label="Amount (to the nearest dollar)">
                                    <span class="input-group-text">บาท</span>
                                </div>
                                <span asp-validation-for="mfee" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>เงินพนักงานพาร์ทไทม์</label>
                                <div class="input-group">
                                    <input type="text" asp-for="mcash" class="form-control allownumericwithdecimal" aria-label="Amount (to the nearest dollar)">
                                    <span class="input-group-text">บาท</span>
                                </div>
                                <span asp-validation-for="mcash" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <!--ROW-->
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label>หมายเหตุ</label>
                                @Html.TextAreaFor(m => m.Remark, new
                                {
                                @class = "form-control full-width",
                                @style = "resize: none;",
                                @cols = 5,
                                @rows = 3,
                                @maxlength = 200,
                                value = "",
                                placeholder = Html.DisplayNameFor(n => n.Remark)
                                })
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                @*<button id="btnCancel" name="btnCancel" type="reset" class="btn btn-cancel me-2">
                    <i class="bx bx-plus"></i>
                    ยกเลิก
                </button>*@
                <a asp-action="Index" asp-controller="Sale" class="btn btn-cancel me-2">ยกเลิก</a>
                <button id="btnSave" name="btnSave" class="btn btn-submit me-2">
                    <i class="bx bx-plus"></i>
                    บันทึกข้อมูล
                </button>
            </div>
        </div>
    </div>
</div>

<!-- /product list -->
@section Scripts{

    <script src="~/assets/plugins/repeater/jquery.repeater.js"></script>
    <script src="~/assets/plugins/pickers/pickadate/picker.js"></script>
    <script src="~/assets/plugins/pickers/pickadate/picker.date.js"></script>
    <script src="~/assets/plugins/pickers/pickadate/picker.time.js"></script>
    <script src="~/assets/plugins/pickers/pickadate/legacy.js"></script>
    @*<script src="~/assets/plugins/pickers/dateTime/pick-a-datetime.js"></script>*@

    <!--Page Script-->
    <script src="~/js/view/sale/sale_create.js" asp-append-version="true"></script>
}