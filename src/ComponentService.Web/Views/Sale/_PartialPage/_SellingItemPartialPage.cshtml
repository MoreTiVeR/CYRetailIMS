@using CYRetailIMS.Application.Common.Models.UI;
@using CYRetailIMS.Application.Services.ItemInBranchService.Queries.GetItemInBranchByBranchID.v1;
@model AddSaleItemViewModel

<input id="totalrow" name="totalrow" value="1" hidden />
<div data-repeater-list="group-a" class="group-a">
    <div data-repeater-item>
        <div class="row justify-content-between">
            <div class="col-md-2 col-sm-12 form-group">
                <div class="position-relative has-icon-left search-box">
                    <select id="ddlSearchItem" name="ddlSearchItem" class="form-control ddl-seatchitem">
                        @if (ViewBag.ItemInBranch is not null)
                        {
                            foreach (var item in ViewBag.ItemInBranch as List<GetItemInBranchByBranchIDItemResponseDTO>)
                            {
                                <option value="@item.itemid">@item.brandname | @item.itemname</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3 col-sm-12 form-group">
                <div class="position-relative has-icon-left">
                    <input type="number" id="txtItemPrice" name="txtItemPrice" class="form-control"  placeholder="ราคาขายสินค้า">
                    <div class="form-control-position">
                        <i class="bx bxs-keyboard"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-sm-12 form-group">
                <div class="position-relative has-icon-left">
                    <input type="number" id="txtItemQty" name="txtItemQty" onchange="return CalculateRateByQty(this.value, this.name)" class="form-control" placeholder="ระบุจำนวน">
                    <div class="form-control-position">
                        <i class="bx bx-money"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-12 form-group">
                <fieldset>
                    <div class="input-group">
                        <input type="number" id="txtAmount" name="txtAmount" class="form-control" placeholder="รวมเงิน"  aria-label="จำนวนเงิน (บาท)" value="0.00">
                        <div class="input-group-append">
                            <span class="input-group-text">THB</span>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-2 col-sm-12 form-group">
                <button id="btnDeleteRow" class="btn btn-danger text-nowrap px-1" data-repeater-delete type="button">
                    <i class="bx bx-x"></i>
                    ลบรายการ
                </button>
            </div>
        </div>
    </div>
</div>