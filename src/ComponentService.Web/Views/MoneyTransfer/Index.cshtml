
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>บันทึกเงินโอน</h4>
        <h6>รายการบันทึกเงินโอนแยกตามสาขา</h6>
    </div>
    <div class="page-btn">
        <a asp-controller="MoneyTransfer" asp-action="Create" class="btn btn-added"><img src="~/assets/img/icons/plus.svg" alt="img" class="me-1">เพิ่มรายการใหม่</a>
    </div>
</div>

<!-- /container -->
<div class="card">
    <div class="card-body">
        <div class="table-top">
            <div class="search-set">
                <div class="search-path">
                    <a class="btn btn-filter" id="filter_search">
                        <img src="~/assets/img/icons/filter.svg" alt="img">
                        <span><img src="~/assets/img/icons/closes.svg" alt="img"></span>
                    </a>
                </div>
                <div class="search-input">
                    <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img"></a>
                </div>
            </div>
        </div>
        <!-- /Filter -->
        <div class="card mb-0" id="filter_inputs">
            <div class="card-body pb-0">
                <div class="row">
                    <div class="col-lg-3 col-sm-6 col-12">
                        <div class="form-group">
                            <select id="ddlBranch" class="ddl-select2 select2 ddl-source-branch" asp-items="@(new SelectList(ViewBag.BranchList, "Value", "Text", null, null))">
                                <option value="">--เลือกสาขา--</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 col-12">
                        <div class="form-group">
                            <div class="input-groupicon">
                                <input id="txtStartDate" type="text" placeholder="จากวันที่" class="datetimepicker">
                                <div class="addonset">
                                    <img src="~/assets/img/icons/calendars.svg" alt="img">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 col-12">
                        <div class="form-group">
                            <div class="input-groupicon">
                                <input id="txtEndDate" type="text" placeholder="ถึงวันที่" class="datetimepicker">
                                <div class="addonset">
                                    <img src="~/assets/img/icons/calendars.svg" alt="img">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 col-12">
                        <div class="form-group" style="text-align: left">
                            <a id="btnSearch" class="btn btn-filters" title="กดเพิ่อค้นหา"><img src="~/assets/img/icons/search-whites.svg" alt="img"></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /Filter -->
        <div class="table-responsive">
            <table id="tbMoneyTransfer" class="table">
                <thead>
                    <tr>
                        <th hidden>
                            <label class="checkboxs">
                                <input type="checkbox" id="select-all">
                                <span class="checkmarks"></span>
                            </label>
                        </th>
                        <th hidden>เลขที่รายการ</th>
                        <th>วันที่โอน</th>
                        <th hidden>รหัสสาขา</th>
                        <th>สาขา</th>
                        <th>เงินโอน</th>
                        <th>รายละเอียด</th>
                        <th>สร้างโดย</th>
                        <th>วันที่สร้าง</th>
                        <th>สถานะ</th>
                        <th>ดำเนินการ</th>
                        <th>รูปสลิป</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- /container -->

@section Scripts{
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script src="~/js/view/moneytransfer/moneytransfer_index.js" asp-append-version="true"></script>
}