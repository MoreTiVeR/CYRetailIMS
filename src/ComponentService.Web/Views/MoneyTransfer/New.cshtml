@using CYRetailIMS.Application.Common.Models.UI
@model CreateMoneyTransferViewModel

@{
    ViewData["Title"] = "เพิ่มรายการโอนเงิน";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/pickadate/pickadate.css">
<link rel="stylesheet" type="text/css" href="~/assets/plugins/pickers/daterange/daterangepicker.css">

<style>
    input[type=time]::-webkit-datetime-edit-ampm-field {
        display: none;
    }
</style>

<div class="page-header">
    <div class="page-title">
        <h4>เพิ่มรายการโอนเงินลูกค้า</h4>
        <h6>บันทึกเงินโอนแยกตามสาขา</h6>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="form-group">
                <form id="frmMoneyTransfer" class="form repeater-default" asp-action="CreateTransactionV2" asp-controller="MoneyTransfer" method="post" enctype="multipart/form-data"
                      data-ajax="true"
                      data-ajax-update=""
                      data-ajax-success="OnSuccess"
                      data-ajax-failure=""
                      data-ajax-begin="">
                    <div class="row">
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>สาขา</label>
                                @Html.DropDownListFor(model => model.BranchID, new SelectList(ViewBag.BranchList, "Value", "Text", null, null), "- กรุณาเลือกสาขา -", new { @class = "select2 form-control" })
                                <span asp-validation-for="BranchID" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>วันที่โอน</label>
                                <div class="input-groupicon">
                                    <input id="txtTransferDate" type="text" asp-for="TransferDate" placeholder="@Html.DisplayNameFor(d => d.TransferDate)" class="pickadate-saledate">
                                    <a class="addonset">
                                        <img src="~/assets/img/icons/calendars.svg" alt="img">
                                    </a>
                                    <span asp-validation-for="TransferDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <fieldset class="form-group">
                                <label>จำนวนเงินโอน</label>
                                <input type="number" class="form-control" asp-for="AmountTransfer" placeholder="@Html.DisplayNameFor(d => d.AmountTransfer)">
                                <span asp-validation-for="AmountTransfer" class="text-danger"></span>
                            </fieldset>
                        </div>
                        <div class="col-lg-2 col-sm-6 col-12"></div>
                    </div>
                    <div class="row" id="divMoneyTransfer">
                        <input id="totalrow" name="totalrow" value="1" hidden />
                        <div id="repeater" data-repeater-list="outer-item-group" class="outer-item-group money-transfer-repeater">
                            <div data-repeater-item class="outer-item-group money-transfer-repeater">
                                <div class="row justify-content-between">
                                    <div class="col-md-3 col-sm-12 form-group">
                                        <div class="position-relative has-icon-left">
                                            <input type="number" id="txtTransferAmount" name="txtTransferAmount" onchange="return CalculateTotalAmountTransfer(this.value, this.name)" class="form-control" placeholder="จำนวนเงินที่โอน">
                                            <div class="form-control-position">
                                                <i class="bx bxs-keyboard"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-sm-12 form-group">
                                        <div class="position-relative has-icon-left">
                                            @* <input type="time" id="myTime" class="form-control" value="16:00:55"> *@
                                            @* <input type="datetime-local" id="txtTransferTime" name="txtTransferTime" class="form-control" /> *@
                                            <input type="time" in="00:00" max="23:59" id="txtTransferTime" name="txtTransferTime" class="form-control" />
                                            @* <input type="time" id="txtTransferTime" name="txtTransferTime" class="form-control" placeholder="เวลาที่โอน">
                                            <div class="form-control-position">
                                            <i class="bx bx-money"></i>
                                            </div> *@
                                        </div>
                                    </div>
                                    @* <div class="col-md-3 col-sm-12 form-group">
                                    <div class="input-group">
                                    <span class="input-group-text">เวลา</span>
                                    <select id="hr" class="form-control">
                                    <option>00:00</option>
                                    </select>
                                    </div>
                                    </div> *@
                                    <div class="col-md-4 col-sm-12 form-group">
                                        <div class="position-relative has-icon-left">
                                            <!--default upload style-->
                                            @* <div class="image-upload">
                                            <input type="file" id="fileUpload" name="fileUpload" class="form-control" accept="image/*" asp-for="ImageFile" lang="th" placeholder="@Html.DisplayNameFor(d => d.ImageFile)">
                                            <div class="image-uploads">
                                            <img src="~/assets/img/icons/upload.svg" alt="img">
                                            <h4>ลากไฟล์วางที่นี่ หรือ คลิก เพื่ออัพโหลดไฟล์</h4>
                                            </div>
                                            </div> *@
                                            <!--default-->
                                            <input type="file" id="fileUpload" name="fileUpload" class="form-control" accept="image/*" asp-for="ImageFile" lang="th" placeholder="@Html.DisplayNameFor(d => d.ImageFile)">
                                        </div>
                                    </div>
                                    @* <div class="image-upload">
                                    <input id="fileUpload" name="fileUpload" type="file" multiple accept="image/*" asp-for="ImageFile" lang="th" placeholder="@Html.DisplayNameFor(d => d.ImageFile)">
                                    <div class="image-uploads">
                                    <img src="~/assets/img/icons/upload.svg" alt="img">
                                    <h4>ลากไฟล์วางที่นี่ หรือ คลิก เพื่ออัพโหลดไฟล์</h4>
                                    </div>
                                    </div> *@
                                    <div class="col-md-2 col-sm-12 form-group">
                                        <button id="btnDeleteRow" class="btn btn-danger text-nowrap" data-repeater-delete type="button">
                                            <i class="fe fe-x"></i>
                                            ลบรายการ
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-lg-12 col-sm-12 col-12">
                            <button id="btnAdd" class="btn btn-primary" data-repeater-create type="button">
                                <i class="fe fe-plus"></i>
                                เพิ่มรายการใหม่
                            </button>
                        </div>
                    </div>

                    <!--รายละเอียด-->
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label class="form-label">หมายเหตุ</label>
                                @Html.TextAreaFor(m => m.Description, new
                                    {
                                        @class = "form-control full-width",
                                        @style = "resize: none;",
                                        @cols = 5,
                                        @rows = 3,
                                        @maxlength = 50,
                                        value = "",
                                        placeholder = Html.DisplayNameFor(n => n.Description)
                                    })
                            </div>
                        </div>
                    </div>

                    <!--Upload-->
                    <div class="row">
                        <div class="col-md-12 col-md-12 col-sm-12">
                            <div class="form-group">
                                <label>รูปถ่ายสลิปโอนเงิน</label>
                                <div class="image-upload">
                                    <input id="fileUpload" type="file" multiple accept="image/*" asp-for="ImageFile" lang="th" placeholder="@Html.DisplayNameFor(d => d.ImageFile)">
                                    <div class="image-uploads">
                                        <img src="~/assets/img/icons/upload.svg" alt="img">
                                        <h4>ลากไฟล์วางที่นี่ หรือ คลิก เพื่ออัพโหลดไฟล์</h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                @* <a asp-action="MoneyTransfer" asp-controller="Item" class="btn btn-cancel me-2">ยกเลิก</a> *@
                <button id="btnCancel" name="btnSave" class="btn btn-cancel me-2">ยกเลิก</button>
                <button id="btnSave" name="btnSave" class="btn btn-submit me-2">
                    <i class="bx bx-plus"></i>
                    บันทึกข้อมูล
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-timepicker/0.5.2/js/bootstrap-timepicker.min.js"></script>
    @* <script>
        $('#timepicker').timepicker({
            minuteStep: 60,
            showMeridian: false,
            defaultTime: '00:00'
        });
    </script> *@
    <script src="~/assets/plugins/repeater/jquery.repeater.js"></script>

    <!--charactersRemaining-->
    <script src="~/lib/display-remaining-characters/jquery.charactersRemaining.min.js"></script>

    <script src="~/assets/plugins/pickers/pickadate/picker.js"></script>
    <script src="~/assets/plugins/pickers/pickadate/picker.date.js"></script>
    <script src="~/assets/plugins/pickers/pickadate/picker.time.js"></script>
    <script src="~/assets/plugins/pickers/pickadate/legacy.js"></script>

    <!--Page Script-->
    <script src="~/js/view/moneytransfer/moneytransfer_create_v2.js" asp-append-version="true"></script>

}