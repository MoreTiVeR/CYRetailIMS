@using CYRetailIMS.Application.Common.Models.UI;
@model PurchaseOrderItemViewModel

<!-- show payment Modal -->
<form id="frmAddAdjustItem" onsubmit="return AddAdjustItem(this)">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">เพิ่มสินค้า</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>สินค้า</label>
                            <select class="select" asp-for="nitemid">
                                @if (ViewBag.ItemList.result)
                                {
                                    <option value="">-- เลือกสินค้า --</option>
                                    foreach (var item in ViewBag.ItemList.data)
                                    {
                                        <option value="@item.itemid">@item.name</option>
                                    }
                                }
                                else
                                {
                                    <option>-- ไม่พบข้อมูลสินค้า --</option>
                                }
                            </select>
                            <span asp-validation-for="nitemid" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>จำนวนสินค้า</label>
                            <input type="number" class="form-control" asp-for="nqty">
                            <span asp-validation-for="nqty" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>จำนวนสินค้า</label>
                            <input type="number" class="form-control" asp-for="price">
                            <span asp-validation-for="price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>จำนวนสินค้า</label>
                            <input type="number" class="form-control" asp-for="amount">
                            <span asp-validation-for="amount" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">ปิด</button>
                <button type="submit" class="btn btn-submit">เพิ่ม</button>
            </div>
        </div>
    </div>
</form>
<!-- show payment Modal -->
