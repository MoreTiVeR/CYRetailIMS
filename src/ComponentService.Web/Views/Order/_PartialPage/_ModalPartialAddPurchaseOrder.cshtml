@using CYRetailIMS.Application.Common.Models.UI;
@using CYRetailIMS.Application.Services.ItemService.Queries.GetItemList.v1;
@model PurchaseOrderItemViewModel

<!-- show payment Modal -->
<form id="frmAddOrderItem" onsubmit="return AddOrderItem(this)">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">เพิ่มสินค้า</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>สินค้า</label>
                            @* <select class="select2" asp-for="nitemid">
                            @if (ViewBag.ItemList.result)
                            {
                            <option value="">-- เลือกสินค้า --</option>
                            foreach (var item in ViewBag.ItemList.data)
                            {
                            <option value="@item.itemid">@item.name</option>
                            }
                            }
                            else
                            {
                            <option>-- ไม่พบข้อมูลสินค้า --</option>
                            }
                            </select>*@
                            <select class="select2" asp-for="nitemid">
                                @if (ViewBag.ItemList.result)
                                {
                                    <option value="" selected>-- กรุณาเลือกสาขา --</option>
                                    foreach (var item in (List<GetItemListResponseDTO>)ViewBag.ItemList.data)
                                    {
                                        <option value="@item.itemid">@item.name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="nitemid" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ราคาสินค้า</label>
                            <input type="number" class="form-control" asp-for="price" onchange="return CalculateAmountByItemPrice(this.value, this.name)" onkeypress="return event.charCode >= 48" min="0">
                            <span asp-validation-for="price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>จำนวนสินค้า</label>
                            <input type="number" class="form-control" asp-for="nqty" onchange="return CalculateAmountByItemQty(this.value, this.name)" onkeypress="return event.charCode >= 48" min="0">
                            <span asp-validation-for="nqty" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>ราคารวมทั้งหมด</label>
                            <input type="number" class="form-control" asp-for="totalprice" onkeypress="return event.charCode >= 48" min="0">
                            <span asp-validation-for="totalprice" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">ปิด</button>
                <button type="submit" class="btn btn-submit">เพิ่ม</button>
            </div>
        </div>
    </div>
</form>
<!-- show payment Modal -->
