@*@using DotNet.Highcharts;
@model Highcharts*@

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /*Fix width select2*/
    .select2-container {
        min-width: 12em !important;
    }
</style>

<!--ROW1-->
<div class="row">
    <div class="col-lg-12 col-sm-12 col-12 d-flex">
        <div class="card flex-fill">
            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">กราฟแสดงยอดขายประจำเดือนแยกตามสาขาประจำปี @(DateTime.Now.ToString("yyyy"))</h4>
                <div class="graph-sets">
                    <div class="col-4">
                        <select name="ddl-source-month" class="ddl-select2 select2 ddl-source-month ms-2">
                            <option value="" selected>- กราฟประจำเดือน -</option>
                            <option value="1">มกราคม</option>
                            <option value="2">กุมภาพันธ์</option>
                            <option value="3">มีนาคม</option>
                            <option value="4">เมษายน</option>
                            <option value="5">พฤษภาคม</option>
                            <option value="6">มิถุนายน</option>
                            <option value="7">กรกฎาคม</option>
                            <option value="8">สิงหาคม</option>
                            <option value="9">กันยายน</option>
                            <option value="10">ตุลาคม</option>
                            <option value="11">พฤศจิกายน</option>
                            <option value="12">ธันวาคม</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div id="container"></div>
                <div id="divEmptyData" style="text-align:center" hidden><label>ไม่พบข้อมูล</label></div>
            </div>
        </div>
    </div>
</div>

<!--ROW2-->
<div class="row">
    <div class="col-lg-12 col-sm-12 col-md-12 col-12 d-flex">
        <div class="card flex-fill">
            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">กราฟแสดงยอดขายรวมประจำปี @(DateTime.Now.ToString("yyyy"))</h4>
            </div>
            <div class="card-body">
                <div id="container2"></div>
                <div id="divEmptyData2" style="text-align:center" hidden><label>ไม่พบข้อมูล</label></div>
            </div>
        </div>
    </div>
</div>

