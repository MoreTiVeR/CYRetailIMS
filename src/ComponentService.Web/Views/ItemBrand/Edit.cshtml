@using CYRetailIMS.Application.Common.Models.UI
@model EditItemBrandViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h4>แก้ไขข้อมูลแบรนด์</h4>
        <h6>ปรับปรุงข้อมูลแบรนดสินค้า</h6>
    </div>
</div>

<!-- /add -->
<div class="card">
    <div class="card-body">
        <form id="frmEditBrand" class="form-edit-brand" onsubmit="return EditBrand(this)">
            <input type="hidden" asp-for="brandid" readonly>
            <div class="row">
                <!--ROW1-->
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>ชื่อแบรนด์สินค้า</label>
                        <input type="text" asp-for="brandname">
                        <span asp-validation-for="brandname" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>ชื่อย่อ</label>
                        <input type="text" asp-for="brandshortname">
                        <span asp-validation-for="brandshortname" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 col-12">
                    <div class="form-group">
                        <label>สาขา</label>
                        @Html.DropDownListFor(model => model.isactive, new SelectList(ViewBag.ActiveStatus, "Value", "Text", null, null), "- กรุณาเลือกสถานะใช้งาน -", new { @class = "select2 form-control" })
                        <span asp-validation-for="isactive" class="text-danger"></span>
                    </div>
                </div>

                <!--ROW2-->
                <div class="row">
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label>รายละเอียด</label>
                            @Html.TextAreaFor(m => m.description, new
                                {
                                    @class = "form-control full-width",
                                    @style = "resize: none;",
                                    @cols = 5,
                                    @rows = 3,
                                    @maxlength = 200,
                                    value = "",
                                    placeholder = Html.DisplayNameFor(n => n.description)
                                })
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-lg-12">
                <a asp-action="Index" asp-controller="ItemBrand" class="btn btn-cancel me-2">ยกเลิก</a>
                <button id="btnSave" name="btnSave" type="submit" class="btn btn-submit me-2">
                    <i class="bx bx-plus"></i>
                    บันทึกข้อมูล
                </button>
            </div>
        </form>
    </div>
</div>
<!-- /add -->
@section Scripts {

    <!--charactersRemaining-->
    <script src="~/lib/display-remaining-characters/jquery.charactersRemaining.min.js"></script>

    <!--Page Script-->
    <script src="~/js/view/itembrand/itembrand_edit.js" asp-append-version="true"></script>
}
