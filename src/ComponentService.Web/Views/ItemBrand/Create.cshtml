@using CYRetailIMS.Application.Common.Models.UI;

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model CreateItemBrandViewModel

<div class="page-header">
    <div class="page-title">
        <h4>เพิ่มแบรนด์สินค้า</h4>
        <h6>เพิ่มแบรนด์สินค้าใหม่</h6>
    </div>
</div>
<!-- /add -->
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="form-group">
                <form id="frmAddBrand" class="form" asp-action="CreateBrand" asp-controller="ItemBrandController" method="post"
                      data-ajax="true"
                      data-ajax-update=""
                      data-ajax-success="OnSuccess"
                      data-ajax-failure=""
                      data-ajax-begin="">
                    <div class="row">
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>ชื่อแบรนด์</label>
                                <input type="text" asp-for="brandname">
                                <span asp-validation-for="brandname" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>ชื่อย่อแบรนด์</label>
                                <input type="text" asp-for="brandshortname">
                                <span asp-validation-for="brandshortname" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label>รายละเอียด</label>
                                @Html.TextAreaFor(m => m.description, new
                                {
                                @class = "form-control full-width",
                                @style = "resize: none;",
                                @cols = 5,
                                @rows = 3,
                                @maxlength = 200,
                                value = "",
                                placeholder = Html.DisplayNameFor(n => n.description)
                                })
                                <span asp-validation-for="description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <button id="btnCancel" name="btnCancel" type="reset" class="btn btn-cancel me-2">
                    <i class="bx bx-plus"></i>
                    ยกเลิก
                </button>
                <button id="btnSave" name="btnSave" type="submit" class="btn btn-submit me-2">
                    <i class="bx bx-plus"></i>
                    บันทึกข้อมูล
                </button>
            </div>
        </div>
    </div>
</div>
<!-- /add -->
@section Scripts{

    <!--Page Script-->
    <script src="~/js/view/itembrand/itembrand_create.js" asp-append-version="true"></script>

    <script>

    </script>
}