                </div>
            </div>
        </div>*@
        <!-- /Filter -->
        <div class="table-responsive">
            <table id="tbEmployees" class="table datanew">
                <thead>
                    <tr>
                        <th hidden>
                            <label class="checkboxs">
                                <input type="checkbox" id="select-all">
                                <span class="checkmarks"></span>
                            </label>
                        </th>
                        @*<th>รหัสพนักงาน</th>*@
                        <th>ชื่อ</th>
                        <th>นามกสุล</th>
                        <th>เบอร์โทร</th>
                        <th>อีเมล</th>
                        <th>บัญชีใช้งานระบบ</th>
                        <th>วันที่สร้าง</th>
                        <th>สถานะพนักงาน</th>
                        <th>ดำเนินการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.EmployeeList.result)
                    {
                        foreach (var item in (List<GetEmployeeResponseDTO>)ViewBag.EmployeeList.data)
                        {
                            string bingingRegisterCss = item.isregister ? "badges bg-lightgreen" : "badges bg-lightred";
                            string bingingRegisterName = item.isregister ? "ผูกบัญชีแล้ว" : "ยังไม่ผูกบัญชี";
                            string empStatusCss = item.isactive ? "badges bg-lightgreen" : "badges bg-lightred";
                            string empStatusName = item.isactive ? "ใช้งาน" : "ไม่ใช้งาน";
                            string rName = $"rowid{item.empid}";
                            Dictionary<string, string> aEmpID = new Dictionary<string, string> { { "empid", item.empid.ToString() } };
                            <tr>
                                <td hidden>
                                    <label class="checkboxs">
                                        <input type="checkbox">
                                        <span class="checkmarks"></span>
                                    </label>
                                </td>
                                @*<td>@item.empcode</td>*@
                                <td>@($"{item.firstname}")</td>
                                <td>@($"{item.lastname}")</td>
                                <td>@item.mobileno</td>
                                <td>@item.email</td>
                                <td><span class="@bingingRegisterCss">@bingingRegisterName</span></td>
                                <th>@($"{@item.createddate:dd/MM/yyyy HH:mm:ss}")</th>
                                <td><span class="@empStatusCss">@empStatusName</span></td>
                                <td>
                                    <a class="me-3" asp-action="Edit" asp-controller="EmployeeManagement" title="แก้ไขข้อมูลพนักงาน" asp-all-route-data="aEmpID">
                                        <img src="~/assets/img/icons/edit.svg" alt="img">
                                    </a>
                                    <a href="#" id="@rName" class="me-3" title="ลบข้อมูลพนักงาน" onclick="deleteEmp(@item.empid)">
                                        <img src="~/assets/img/icons/delete.svg" alt="img">
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- /product list -->
@section Scripts{

    <script>
    </script>
    <!--Page Script-->
    <script src="~/js/view/employee/employee_index.js" asp-append-version="true"></script>
}